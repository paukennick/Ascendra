# Per-machine Claude Code / Headroom local state — paths and PIDs are
# machine-specific; do not commit.
.claude/settings.local.json
.claude/.headroom_wrap_*

.vercel
.env*

# The vendored agent package's own staging directory. `omni agents sync`
# renders straight to .claude/agents/, .claude/skills/ and managed-agents/,
# so this only appears if someone runs .ai/agent-team/build.py by hand.
.ai/agent-team/dist/

# `./omni` sets sys.dont_write_bytecode, but `python make_ai.py` does not.
__pycache__/

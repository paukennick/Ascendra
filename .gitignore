# Per-machine Claude Code / Headroom local state — paths and PIDs are
# machine-specific; do not commit.
.claude/settings.local.json
.claude/.headroom_wrap_*

.vercel
.env*

# Generated by `omni graph build|view|render` — rebuilt from source on demand,
# several MB each, and stale the moment the tree changes. Upstream
# OmniEngineering ignores the same three paths.
.ai/project-graph.json
.ai/project-graph.svg
.ai/project-graph.html

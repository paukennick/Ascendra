{
  "expo": {
    "name": "Ascendra",
    "slug": "prep-lms",
    "scheme": [
      "preplms",
      "com.hel1x.ascendra",
      "com.googleusercontent.apps.451728570008-pj4ub202h62klomfj5cssg8dbmvprvti",
      "com.googleusercontent.apps.451728570008-ptkelqpv2r7ukgegq1831ls08fribvjl"
    ],
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.hel1x.ascendra",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      }
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0f172a"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ascendra needs access to your photos so you can set a profile picture.",
          "cameraPermission": "Ascendra needs access to your camera so you can take a profile picture."
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "c368ac7a-b423-443a-99b4-e9823121821b"
      }
    },
    "owner": "hel1x",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c368ac7a-b423-443a-99b4-e9823121821b"
    },
    "ios": {
      "bundleIdentifier": "com.hel1x.ascendra",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Ascendra uses Face ID to unlock your account quickly and securely."
      }
    }
  }
}

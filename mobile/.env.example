# For local development with `expo start`, copy this to .env.local and set the URL of
# your deployed backend (or a local tunnel URL if running the backend locally).
# Any env var prefixed EXPO_PUBLIC_ is inlined into the JS bundle at build time — this is
# fine for a base URL, but never put a secret (like ANTHROPIC_API_KEY) in an EXPO_PUBLIC_ var,
# since it would ship inside the APK and be extractable. All API keys stay server-side in backend/.

EXPO_PUBLIC_API_URL=https://your-vercel-deployment.vercel.app

# For a production EAS build (eas build -p android --profile production), this value is read
# from mobile/eas.json's build.production.env.EXPO_PUBLIC_API_URL instead of this file —
# update that value there too before building.

# Google Sign-In: one OAuth client ID per platform, created in Google Cloud Console as
# "Android" (package name + signing cert SHA-1) and "iOS" (bundle ID) client types --
# not "Web application" (see src/auth/googleSignIn.ts for why). Add both to the backend's
# GOOGLE_OAUTH_CLIENT_IDS too. The sign-in button stays hidden on a platform until its ID is set.
# For EAS builds, these also need to be added to mobile/eas.json's build.production.env.
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=xxxxxxxxxx-yyyyyyyyyy.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=xxxxxxxxxx-zzzzzzzzzz.apps.googleusercontent.com

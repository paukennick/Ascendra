{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "crons": [
    {
      "path": "/api/health",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/purge-auth-data",
      "schedule": "30 9 * * *"
    },
    {
      "path": "/api/cron/content-signals",
      "schedule": "40 10 * * *"
    },
    {
      "path": "/api/cron/service-emails",
      "schedule": "10 16 * * *"
    }
  ]
}

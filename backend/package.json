{
  "name": "prep-lms-backend",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "bash scripts/build-webapp.sh && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test lib/*.test.ts scripts/eval/*.test.ts scripts/*.test.ts \"lib/sim/**/*.test.ts\"",
    "test:db": "tsx --test --test-concurrency=1 lib/*.dbtest.ts",
    "seed": "tsx supabase/seed/seed.ts",
    "migrate": "tsx supabase/apply-migration.ts",
    "pregen": "tsx scripts/pregenerate.ts",
    "items": "tsx scripts/item-quality.ts",
    "metrics": "tsx scripts/metrics.ts",
    "billing:grant": "tsx scripts/billing-grant.ts",
    "billing:config": "tsx scripts/billing-config.ts",
    "eval:lessons": "tsx scripts/eval/lessons.ts",
    "eval:grading": "tsx scripts/eval/grading.ts",
    "eval:live": "tsx scripts/eval/live.ts",
    "labs:generate": "tsx scripts/generate-labs.ts",
    "sim:sync-engine": "tsx scripts/sim-sync-engine.ts",
    "sim:cross-runtime": "tsx scripts/sim-cross-runtime.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@vercel/oidc": "^3.8.8",
    "bcryptjs": "^3.0.3",
    "google-auth-library": "11.1.0",
    "jimp-compact": "^0.16.1-2",
    "jsonwebtoken": "^9.0.3",
    "next": "^16.3.8",
    "otplib": "13.5.0",
    "pg": "8.12.0",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "resend": "^6.28.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "22.20.5",
    "@types/pg": "8.11.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "18.3.3",
    "tsx": "^4.23.13",
    "typescript": "5.5.4"
  },
  "overrides": {
    "zod": "$zod"
  }
}

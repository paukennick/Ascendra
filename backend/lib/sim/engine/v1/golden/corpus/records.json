          "fill",
          "edit",
          "sum"
        ],
        "clock": "running"
      }
    },
    "initialPhase": "main",
    "actions": {
      "fill": {
        "label": "fill",
        "group": "g",
        "effects": [
          {
            "push": "items",
            "value": {
              "kind": "'a'",
              "n": "1"
            }
          },
          {
            "push": "items",
            "value": {
              "kind": "'b'",
              "n": "2"
            }
          },
          {
            "push": "items",
            "value": {
              "kind": "'a'",
              "n": "3"
            }
          }
        ]
      },
      "edit": {
        "label": "edit",
        "group": "g",
        "effects": [
          {
            "update": "items",
            "where": "kind == 'a'",
            "set": {
              "n": "n * 10"
            }
          },
          {
            "remove": "items",
            "where": "_id == 2"
          },
          {
            "push": "items",
            "value": {
              "kind": "'b'",
              "n": "4"
            }
          }
        ]
      },
      "sum": {
        "label": "sum",
        "group": "g",
        "effects": [
          {
            "each": "it",
            "in": "items",
            "do": [
              {
                "add": "total",
                "by": "it.n"
              }
            ]
          },
          {
            "cases": [
              {
                "when": "total > 100",
                "then": [
                  {
                    "set": "branch",
                    "to": "1"
                  }
                ]
              },
              {
                "when": "total > 10",
                "then": [
                  {
                    "set": "branch",
                    "to": "2"
                  }
                ]
              },
              {
                "when": "true",
                "then": [
                  {
                    "set": "branch",
                    "to": "3"
                  }
                ]
              }
            ]
          },
          {
            "if": "branch == 2",
            "then": [
              {
                "add": "branch",
                "by": "5"
              }
            ],
            "else": [
              {
                "set": "branch",
                "to": "0"
              }
            ]
          }
        ]
      }
    },

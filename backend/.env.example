# Copy this file to .env.local for local development.
# In production (Vercel), set these same names under Project Settings -> Environment Variables.
# NEVER commit a real .env / .env.local file, and never paste a real key into code or into chat with Claude.

# Anthropic auth: either a static API key (local dev) or Workload Identity
# Federation (production on Vercel — no static secret stored). ANTHROPIC_API_KEY
# is checked first if present; see lib/anthropic.ts for the precedence.

# Local dev only — get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Production only (Vercel). Created via Claude Console -> Settings -> Workload
# identity -> Connect workload -> Custom OIDC, trusting Vercel's OIDC issuer
# (https://oidc.vercel.com/<team-slug>, enabled under this Vercel project's
# Settings -> Security). These are identifiers, not secrets — a token exchange
# still requires a valid signed OIDC JWT from the trusted Vercel issuer.
# ANTHROPIC_FEDERATION_RULE_ID=fdrl_...
# ANTHROPIC_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000
# ANTHROPIC_SERVICE_ACCOUNT_ID=svac_...
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# Which Claude model to call for lesson generation (generated once per
# objective, then cached — see lesson_content table — so its cost doesn't
# scale with users). Defaults to claude-sonnet-5-5 when unset.
# Model ids: https://platform.claude.com/docs/en/about-claude/models
# Production: confirm this id against that page before deploying (the catalog
# changes), and set it explicitly rather than relying on the code default.
# To roll back to the previous generation, set claude-sonnet-4-5 (retiring
# 2026-11-30, tentative) — lib/anthropic.ts sends the right parameters for
# either generation, no code change needed. Never set a model id this repo's
# modelParams() doesn't know without checking: unknown ids are sent no
# thinking/effort settings and log a warning.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Cheaper model for uncached, per-interaction calls (chat, grading, guess
# feedback, PBQ) that recur per user rather than once per objective. Defaults
# to claude-haiku-5-5 when unset. Same advice as above: confirm the id for
# production. Previous generation: claude-haiku-4-5-20251001.
ANTHROPIC_FAST_MODEL=claude-haiku-5-5

# Optional. Set to "off" to stop recording model calls in the ai_calls table
# (migration 028). Recording is on by default and can never fail a request.
# The eval scripts in scripts/eval set this themselves.
# AI_CALL_LOG=off

# Optional (Audit 3, REQ-115). Per-learner daily AI spend budget in USD, summed
# from ai_calls over the last 24 hours. When reached, coach chat and lesson
# regenerate answer 429 with a plain message (REQ-202: every other model call is
# held to a daily pool too, see below). Default
# 0.50 (about 3x a heavy learner's day); "off" or 0 disables it.
# AI_DAILY_BUDGET_USD=0.50
# REQ-202: the learner's separate daily pool for grading their own answers
# (typed answers, PBQs, lab steps, review and unit checks, explain-back). Same
# rolling 24 hours; the coach pool above no longer includes it. "off" or 0
# disables it.
# AI_DAILY_GRADING_BUDGET_USD=0.25
# REQ-144: unrestricted access (docs/billing.md). OWNER_EMAILS: comma-separated
# owner addresses (verified accounts only); owners have unrestricted access and
# manage it for others in Settings > Access. Unrestricted accounts get a daily
# AI safety ceiling instead of the budget above (default 20; cannot be off).
# OWNER_EMAILS=
# AI_UNRESTRICTED_DAILY_CEILING_USD=20
# OWNER_MONTHLY_AI_CAP_USD=35
# REQ-122: paid tiers (docs/billing.md). ALL OPTIONAL; billing is OFF unless
# BILLING_ENABLED is set to something other than 0/false/off/no. While off,
# every learner is treated as Pro and the app shows no plans or prices.
# BILLING_ENABLED=false
# Allowances (counts learners see), per kind and tier; "none" = no count:
# BILLING_ALLOWANCE_COACH_MESSAGE_PLUS=20
# BILLING_ALLOWANCE_REGENERATION_PLUS=5
# BILLING_ALLOWANCE_REGENERATION_PRO=15
# BILLING_ALLOWANCE_MOCK_EXAM_PLUS=1
# BILLING_ALLOWANCE_GRADED_ANSWER_FREE=3
# REQ-170: category plans (docs/billing.md, "Prices"). Prices are not final:
# each is BILLING_PRICE_<FAMILY>_<PERIOD>_USD, e.g.
# BILLING_PRICE_IT_CLOUD_PLUS_MONTHLY_USD=12.99
# BILLING_PRICE_ALL_ACCESS_YEARLY_USD=199
# BILLING_PRICE_CLINICAL_PRO_YEARLY_USD=      # adds a length that has no default
# Monthly AI cap per plan in USD of model spend ("off" removes it); defaults
# are half the yearly take after fees. Learners never see dollars; at the cap
# coach chat and lesson regenerate pause.
# AI_MONTHLY_CAP_IT_CLOUD_PLUS_USD=2.95
# AI_MONTHLY_CAP_ALL_ACCESS_USD=7.35
# AI_MONTHLY_CAP_CLINICAL_PRO_USD=14.61
# AI_MONTHLY_CAP_PLUS_USD=2.95                # grants (comps) at Plus
# AI_MONTHLY_CAP_PRO_USD=7.35                 # grants (comps) at Pro
# AI_MONTHLY_CAP_UNRESTRICTED_USD=20.16       # owner-granted unrestricted access (all-access + clinical add-on)
# BILLING_FREE_COURSE_SWITCH_DAYS=7
# Webhook secrets (set before pointing the providers at the webhooks):
# REVENUECAT_WEBHOOK_AUTH=       # the Authorization header value set in RevenueCat
# STRIPE_WEBHOOK_SECRET=         # whsec_... from the Stripe webhook endpoint
# Web checkout (Stripe Checkout). Without the key, /api/billing/checkout is a 503:
# STRIPE_SECRET_KEY=             # sk_live_... / sk_test_... -- server only, never EXPO_PUBLIC_
# STRIPE_PRICE_<PLAN ID>=       # price_... ids from Stripe, one per plan (24), e.g.
# STRIPE_PRICE_IT_CLOUD_PLUS_MONTHLY=
# STRIPE_PRICE_PM_PRO_YEARLY=
# STRIPE_PRICE_ALL_ACCESS_QUARTERLY=
# STRIPE_PRICE_CLINICAL_PRO_MONTHLY=
# STRIPE_PRICE_CLINICAL_ADDON_MONTHLY=
# BILLING_WEB_RETURN_URL=https://www.ascendra-learn.com   # where Checkout returns
# REQ-166: verified group discounts (docs/billing.md, "Verified discounts").
# OFF unless BILLING_ENABLED and VERIFIED_DISCOUNTS_ENABLED are on, a
# verification provider is configured, and a group has a published percentage.
# VERIFIED_DISCOUNTS_ENABLED=false
# VERIFIED_DISCOUNT_GROUPS=military,responder,nurse,student   # default set; add teacher to offer it
# DISCOUNT_PERCENT_MILITARY=      # published %, 1-25 (REQ-170: above 25 is refused); no default (Nick sets them)
# DISCOUNT_PERCENT_RESPONDER=
# DISCOUNT_PERCENT_NURSE=
# DISCOUNT_PERCENT_STUDENT=
# DISCOUNT_PERCENT_TEACHER=
# STRIPE_COUPON_MILITARY=         # Stripe coupon id per group (web checkout)
# STRIPE_COUPON_RESPONDER=
# STRIPE_COUPON_NURSE=
# STRIPE_COUPON_STUDENT=
# STRIPE_COUPON_TEACHER=
# PLAY_OFFER_MILITARY=verified-military   # Google Play developer-determined offer id per group (these are the defaults)
# APP_STORE_OFFER_REDEEM_URL=     # App Store Connect's example redemption link, without the code
# VERIFIED_DISCOUNT_VALID_DAYS=365

# Optional. Estimated-token cap on the coach chat history sent per message
# (trimmed in fixed chunks so prompt caching holds). Default 8000; minimum 1000.
# CHAT_HISTORY_TOKEN_BUDGET=8000

# Supabase Postgres connection string (Project Settings -> Database -> Connection string -> URI).
# Use the "Transaction" pooler connection string (port 6543) for serverless/Vercel deployments.
DATABASE_URL=postgres://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# The seeded user's email — used only by supabase/seed/seed.ts. Real requests
# authenticate via a bearer access token (see /api/auth/*), not this lookup.
DEFAULT_USER_EMAIL=pak@example.com

# --- Auth ---------------------------------------------------------------------
# Secret used to sign/verify short-lived (15 min) access-token JWTs. Generate
# a long random value, e.g. `openssl rand -base64 48`, and never reuse it
# across environments. Rotating this instantly invalidates every issued
# access token (refresh tokens are unaffected — they're opaque, stored
# hashed, and verified against the database, not this secret).
AUTH_JWT_SECRET=change-me-to-a-long-random-value

# Keys the per-learner shuffle of lesson answer choices (lib/choice-order.ts).
# REQUIRED IN PRODUCTION: with NODE_ENV=production (Vercel) and this unset,
# every lesson and grade fails with "CHOICE_ORDER_SECRET is not set". In
# development and tests, unset falls back to a key derived from
# AUTH_JWT_SECRET. Generate one with `openssl rand -base64 48`; never reuse
# another secret or share it across environments. Changing it reshuffles
# every learner's choices (only matters for a lesson open mid-answer).
# CHOICE_ORDER_SECRET=

# Base URL this backend is reachable at — used to build the links sent in
# verification/password-reset emails (e.g. https://backend-mauve-mu-18.vercel.app).
# For local dev, http://localhost:3000 is fine.
APP_BASE_URL=http://localhost:3000

# Encrypts TOTP (MFA) secrets at rest -- unlike a password, a TOTP secret
# can't just be hashed, since verifying a 6-digit code needs the raw secret
# back. Must decode to exactly 32 bytes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this makes every currently-enrolled user's MFA unreadable -- they'd
# need to disable and re-enroll. Never reuse across environments.
AUTH_ENCRYPTION_KEY=change-me-to-a-32-byte-base64-value

# Comma-separated Google OAuth 2.0 client IDs, one per platform your Expo app
# is built for (a web/Expo-Go client ID and separate iOS/Android client IDs
# are common) -- create these at https://console.cloud.google.com/apis/credentials
# (APIs & Services -> Credentials -> Create Credentials -> OAuth client ID).
# Any ID token whose audience matches one of these is accepted; see
# lib/auth/oauth.ts. "Sign in with Google" is disabled with a clear error
# until this is set.
GOOGLE_OAUTH_CLIENT_IDS=xxxxxxxxxx-yyyyyyyyyy.apps.googleusercontent.com

# Resend API key for sending verification/password-reset emails — create an
# account and key at https://resend.com/api-keys (free tier: 3,000 emails/mo,
# 100/day, plenty for a handful of real users). Registration/login will error
# with a clear "RESEND_API_KEY is not set" message until this is configured.
RESEND_API_KEY=re_...

# "From" address for auth emails. Resend's shared onboarding@resend.dev
# address works for testing without verifying your own domain, but Resend
# delivers it ONLY to the Resend account's own address -- real users get no
# verification, reset or MFA mail. Verify a sending domain in the Resend
# dashboard and set this in production (e.g. "Ascendra <no-reply@your-domain>").
# REQ-191: /api/health reports "email":"unconfigured" in production while it
# is unset or @resend.dev, and a refused send is logged as an
# `email_send_failed` line (docs/operations-runbook.md, "Email sender").
EMAIL_FROM=onboarding@resend.dev

# Where support tickets and course-addition requests are emailed when a user
# submits one (POST /api/support). The submission is stored in the
# support_requests table either way -- this only controls the notification,
# and falls back to EMAIL_FROM when unset. Replies go to the submitting user.
SUPPORT_EMAIL=

# REQ-205: the support inbox. The public support address is SUPPORT_EMAIL, or
# support@ascendra-learn.com when it is unset (lib/support-contact.ts; Nick has
# not confirmed it). Mail sent to it is received by Resend, which calls
# POST /api/inbound/email; the route checks RESEND_WEBHOOK_SECRET (the
# webhook's signing secret, "whsec_...") and forwards the message to
# SUPPORT_FORWARD_TO, as plain text. All three must be set, and
# SUPPORT_FORWARD_TO must not be on the support address's own domain; if any
# is missing the route answers 503 and forwards nothing. Setup:
# docs/operations-runbook.md "Support inbox".
RESEND_WEBHOOK_SECRET=
SUPPORT_FORWARD_TO=

# Bearer token the quarterly catalog-review Managed Agent (REQ-042) uses to
# call GET /api/catalog/review-context and POST /api/catalog/review-findings.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# The same value also has to be registered as an Anthropic vault
# `environment_variable` credential so the agent's sandbox can use it --
# never paste it into the agent's system prompt or task text.
CATALOG_REVIEW_AGENT_TOKEN=change-me-to-a-long-random-value

# Extra CORS origins allowed to call this API from a browser, on top of the
# defaults baked into proxy.ts (the production web app, plus localhost:8081
# outside production only).
# Comma-separated. Only needed for browser clients (e.g. testing the Expo web
# preview from another device on your LAN) -- the native mobile app doesn't
# send an Origin header, so this never affects it.
ALLOWED_ORIGINS=

# Secret Vercel Cron sends (as "Authorization: Bearer <value>") to
# GET /api/cron/purge-auth-data, the daily purge of sign-in events and spent
# credentials older than 90 days (REQ-116, vercel.json crons). Generate with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Until it is set the purge route refuses to run. In production the server
# also refuses to start while any secret above still has its placeholder.
CRON_SECRET=

# --- Service emails (REQ-197) -------------------------------------------------
# The daily /api/cron/service-emails run (exam change notices, exam countdown,
# opt-in weekly digest) sends nothing until this is "true". Switch it on
# together with the Privacy Policy update that describes these emails.
SERVICE_EMAILS_ENABLED=
# Learners mailed per kind per run (default 25); the rest go the next day.
# SERVICE_EMAIL_BATCH=25
# The weekly digest refuses to send until BOTH are set: the postal address
# shown in its footer, and its own sender (e.g. on a separate subdomain, so
# digest reputation never affects sign-in mail).
MAIL_POSTAL_ADDRESS=
DIGEST_EMAIL_FROM=

# --- Local-dev-only alternate AI provider ------------------------------------
# Leave AI_PROVIDER unset (or "anthropic") for normal use, including production.
# Set AI_PROVIDER=local to route chat/grade/lesson/pbq calls to a self-hosted
# Ollama instance instead of Claude — free, but noticeably lower quality, and
# only ever meant for local iteration, never for a deployed environment: the
# server refuses to start in production with it set (lib/env-check.ts).
# AI_PROVIDER=local

# Base URL of the Ollama instance. If Ollama runs on this same machine, the
# default (http://localhost:11434) is correct. If it runs on another
# workstation on your network, point this at that machine's LAN address, e.g.
# http://192.168.1.42:11434 — and on that workstation, Ollama must be started
# with OLLAMA_HOST=0.0.0.0 (it only listens on localhost by default), with
# Windows Firewall allowing inbound connections on port 11434.
# OLLAMA_BASE_URL=http://localhost:11434

# Which model tag Ollama should use — must already be pulled on the host
# (`ollama pull qwen2.5:7b-instruct`). Qwen2.5 7B Instruct is a reasonable
# default for 8GB-VRAM-class GPUs and produces cleaner structured JSON output
# than most small models this app's lesson/PBQ generation depends on.
# OLLAMA_MODEL=qwen2.5:7b-instruct

# --- Operations and feature switches (FAIL-1163) -----------------------------
# Every name below is read by the code and is optional. The value shown is the
# behaviour when the name is unset, so uncommenting a line as written changes
# nothing. docs/operations-runbook.md says where the operational ones matter.

# AI access (REQ-201, lib/ai-access-config.ts). all = everyone (default);
# granted = full AI only for owners and accounts an owner granted; paid = AI
# follows the billing tiers. A typo is treated as granted and reported by the
# env check.
# AI_ACCESS_MODE=all
# Total model spend per UTC day across every learner, in USD. Unset, "off" or
# 0 = no ceiling. At it, coach chat and lesson regenerate pause (owners
# excepted) and un-opened lessons answer "being prepared".
# AI_GLOBAL_DAILY_CEILING_USD=

# Error tracker (REQ-118, lib/error-tracker.ts): a Sentry DSN. Unset = server
# errors are only logged, nothing is sent.
# ERROR_TRACKER_DSN=

# Minimum app version (REQ-175, proxy.ts): a semver such as 1.4.0. An app build
# below it gets 426 "update required". Unset = no minimum.
# MIN_APP_VERSION=
# App Store page the update screen opens on iOS (https://apps.apple.com/...).
# Unset = the iOS update screen has no store button.
# IOS_APP_STORE_URL=

# Database connection (lib/db-connection.ts). Pin the CA the server's
# certificate must chain to (REQ-207): the PEM text (a literal "\n" is
# accepted) or a path to the PEM file. PGSSLROOTCERT is libpq's name for the
# same thing. Both unset = encrypted but not verified.
# DATABASE_CA_CERT=
# PGSSLROOTCERT=
# "disable" turns TLS off: for a throwaway local or CI Postgres only, never
# production.
# PGSSLMODE=
# Statement timeout sent when connecting, in ms (0 = off, max 600000). Unset =
# 25000 on a direct or local Postgres and nothing on a pooler (the app_runtime
# role carries its own 25 s timeout, migration 071).
# DB_STATEMENT_TIMEOUT_MS=
# Session lock_timeout for `npm run migrate` ("10s", "500ms", "1min"; 0 = off).
# MIGRATION_LOCK_TIMEOUT=5s

# Simulations (REQ-199, lib/sim/server-run.ts). Off unless set to something
# other than 0/false/off/no.
# SIMS_ENABLED=false
# Which screen types are on, comma-separated.
# SIMS_RENDERERS=bedside,board,session,treatment-session
# Serve simulations still waiting for review. On unless set off.
# SIMS_SERVE_UNREVIEWED=on
# Serve labs still waiting for expert review (lib/labs.ts). On unless set off.
# LABS_SERVE_UNREVIEWED=on

# Second-model fact-check before generated items publish (lib/fact-check.ts).
# On unless set to off/0/false/no; off lets items publish unchecked.
# ITEM_FACT_CHECK=on

# "true" sends the Content-Security-Policy as report-only (violations are
# logged in the browser console, nothing is blocked). Any other value = enforced
# (security-headers.js).
# CSP_REPORT_ONLY=false

# Public base URL of the web app. Only a fallback for BILLING_WEB_RETURN_URL
# (where Stripe Checkout and the discount verification return); APP_BASE_URL
# above is what builds the links in emails.
# APP_URL=

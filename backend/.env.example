# Copy this file to .env.local for local development.
# In production (Vercel), set these same names under Project Settings -> Environment Variables.
# NEVER commit a real .env / .env.local file, and never paste a real key into code or into chat with Claude.

# Anthropic auth: either a static API key (local dev) or Workload Identity
# Federation (production on Vercel — no static secret stored). ANTHROPIC_API_KEY
# is checked first if present; see lib/anthropic.ts for the precedence.

# Local dev only — get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Production only (Vercel). Created via Claude Console -> Settings -> Workload
# identity -> Connect workload -> Custom OIDC, trusting Vercel's OIDC issuer
# (https://oidc.vercel.com/<team-slug>, enabled under this Vercel project's
# Settings -> Security). These are identifiers, not secrets — a token exchange
# still requires a valid signed OIDC JWT from the trusted Vercel issuer.
# ANTHROPIC_FEDERATION_RULE_ID=fdrl_...
# ANTHROPIC_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000
# ANTHROPIC_SERVICE_ACCOUNT_ID=svac_...
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# Which Claude model to call for lesson generation (generated once per
# objective, then cached — see lesson_content table — so its cost doesn't
# scale with users).
# Pick a current Claude Sonnet or Haiku model id from https://docs.anthropic.com/en/docs/about-claude/models
# The value below is a placeholder — confirm the exact current model string before deploying,
# since the model catalog changes over time and this was filled in without live access to it.
ANTHROPIC_MODEL=claude-sonnet-4-5

# Cheaper model for uncached, per-interaction calls (chat, grading, PBQ
# generation) that recur per user rather than once per objective.
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001

# Supabase Postgres connection string (Project Settings -> Database -> Connection string -> URI).
# Use the "Transaction" pooler connection string (port 6543) for serverless/Vercel deployments.
DATABASE_URL=postgres://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# The seeded user's email — used only by supabase/seed/seed.ts. Real requests
# authenticate via a bearer access token (see /api/auth/*), not this lookup.
DEFAULT_USER_EMAIL=pak@example.com

# --- Auth ---------------------------------------------------------------------
# Secret used to sign/verify short-lived (15 min) access-token JWTs. Generate
# a long random value, e.g. `openssl rand -base64 48`, and never reuse it
# across environments. Rotating this instantly invalidates every issued
# access token (refresh tokens are unaffected — they're opaque, stored
# hashed, and verified against the database, not this secret).
AUTH_JWT_SECRET=change-me-to-a-long-random-value

# Base URL this backend is reachable at — used to build the links sent in
# verification/password-reset emails (e.g. https://backend-mauve-mu-18.vercel.app).
# For local dev, http://localhost:3000 is fine.
APP_BASE_URL=http://localhost:3000

# Encrypts TOTP (MFA) secrets at rest -- unlike a password, a TOTP secret
# can't just be hashed, since verifying a 6-digit code needs the raw secret
# back. Must decode to exactly 32 bytes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this makes every currently-enrolled user's MFA unreadable -- they'd
# need to disable and re-enroll. Never reuse across environments.
AUTH_ENCRYPTION_KEY=change-me-to-a-32-byte-base64-value

# Comma-separated Google OAuth 2.0 client IDs, one per platform your Expo app
# is built for (a web/Expo-Go client ID and separate iOS/Android client IDs
# are common) -- create these at https://console.cloud.google.com/apis/credentials
# (APIs & Services -> Credentials -> Create Credentials -> OAuth client ID).
# Any ID token whose audience matches one of these is accepted; see
# lib/auth/oauth.ts. "Sign in with Google" is disabled with a clear error
# until this is set.
GOOGLE_OAUTH_CLIENT_IDS=xxxxxxxxxx-yyyyyyyyyy.apps.googleusercontent.com

# Resend API key for sending verification/password-reset emails — create an
# account and key at https://resend.com/api-keys (free tier: 3,000 emails/mo,
# 100/day, plenty for a handful of real users). Registration/login will error
# with a clear "RESEND_API_KEY is not set" message until this is configured.
RESEND_API_KEY=re_...

# "From" address for auth emails. Resend's shared onboarding@resend.dev
# address works for testing without verifying your own domain, but is not
# usable in production — verify a sending domain in the Resend dashboard
# before relying on this for real users.
EMAIL_FROM=onboarding@resend.dev

# Where support tickets and course-addition requests are emailed when a user
# submits one (POST /api/support). The submission is stored in the
# support_requests table either way -- this only controls the notification,
# and falls back to EMAIL_FROM when unset. Replies go to the submitting user.
SUPPORT_EMAIL=

# Bearer token the quarterly catalog-review Managed Agent (REQ-042) uses to
# call GET /api/catalog/review-context and POST /api/catalog/review-findings.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# The same value also has to be registered as an Anthropic vault
# `environment_variable` credential so the agent's sandbox can use it --
# never paste it into the agent's system prompt or task text.
CATALOG_REVIEW_AGENT_TOKEN=change-me-to-a-long-random-value

# Extra CORS origins allowed to call this API from a browser, on top of the
# defaults baked into proxy.ts (the production web app and localhost:8081).
# Comma-separated. Only needed for browser clients (e.g. testing the Expo web
# preview from another device on your LAN) -- the native mobile app doesn't
# send an Origin header, so this never affects it.
ALLOWED_ORIGINS=

# --- Local-dev-only alternate AI provider ------------------------------------
# Leave AI_PROVIDER unset (or "anthropic") for normal use, including production.
# Set AI_PROVIDER=local to route chat/grade/lesson/pbq calls to a self-hosted
# Ollama instance instead of Claude — free, but noticeably lower quality, and
# only ever meant for local iteration, never for a deployed environment.
# AI_PROVIDER=local

# Base URL of the Ollama instance. If Ollama runs on this same machine, the
# default (http://localhost:11434) is correct. If it runs on another
# workstation on your network, point this at that machine's LAN address, e.g.
# http://192.168.1.42:11434 — and on that workstation, Ollama must be started
# with OLLAMA_HOST=0.0.0.0 (it only listens on localhost by default), with
# Windows Firewall allowing inbound connections on port 11434.
# OLLAMA_BASE_URL=http://localhost:11434

# Which model tag Ollama should use — must already be pulled on the host
# (`ollama pull qwen2.5:7b-instruct`). Qwen2.5 7B Instruct is a reasonable
# default for 8GB-VRAM-class GPUs and produces cleaner structured JSON output
# than most small models this app's lesson/PBQ generation depends on.
# OLLAMA_MODEL=qwen2.5:7b-instruct

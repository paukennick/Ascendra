{
  "schemaVersion": 1,
  "engine": {
    "major": 1,
    "minor": 2
  },
  "slug": "sql-export-pages-without-order",
  "title": "Some members twice, some never",
  "screen": {
    "type": "data",
    "level": 1,
    "data": {
      "workspace": "member_export.sql, the paged export to the mailing house, Brightwater Credit Union (fictional)",
      "flags": [
        {
          "id": "ask",
          "label": "Marketing lead, Jo Hart",
          "text": "The mailing house says 1,140 members got two statements and about as many got none. The next export goes at 11:00.",
          "when": "true",
          "severity": "info"
        },
        {
          "id": "seen",
          "label": "Pattern",
          "text": "The total row count is right, but the pages overlap.",
          "when": "not isNull(lookAt) and not fixed",
          "severity": "warning"
        },
        {
          "id": "lock",
          "label": "Mailing house",
          "text": "11:00: the export window closed.",
          "when": "not isNull(lockedAt)",
          "severity": "error"
        }
      ],
      "charts": [],
      "tables": [],
      "code": [
        {
          "id": "code",
          "label": "member_export.sql",
          "language": "SQL",
          "lines": [
            {
              "id": "c0",
              "text": "SELECT member_id, name, address FROM members WHERE active"
            },
            {
              "id": "c1",
              "text": "LIMIT 1000 OFFSET :page * 1000;",
              "when": "fix == \"bug\"",
              "mark": "not isNull(lookAt) ? \"error\" : \"none\""
            },
            {
              "id": "c2",
              "text": "ORDER BY member_id LIMIT 1000 OFFSET :page * 1000;",
              "when": "fix == \"pk\"",
              "mark": "\"changed\""
            },
            {
              "id": "c3",
              "text": "ORDER BY joined_on LIMIT 1000 OFFSET :page * 1000;",
              "when": "fix == \"date\"",
              "mark": "\"warning\""
            },
            {
              "id": "c4",
              "text": "LIMIT 48000;",
              "when": "fix == \"one\"",
              "mark": "\"warning\""
            }
          ]
        }
      ],
      "meters": [
        {
          "id": "due",
          "label": "Export",
          "value": "11:00"
        }
      ]
    }
  },
  "objective": "Limit and page results with LIMIT/OFFSET or FETCH FIRST, always paired with ORDER BY",
  "secondaryObjectives": [
    "Sort results with ORDER BY on one or more columns, ascending and descending"
  ],
  "sources": [
    {
      "cite": "PostgreSQL 19 documentation, 7.6 LIMIT and OFFSET",
      "checkedAt": "2026-11-17",
      "url": "https://www.postgresql.org/docs/19/queries-limit.html",
      "note": "Read 2026-11-17 through a summarizing fetch. 'When using LIMIT, it is important to use an ORDER BY clause that constrains the result rows into a unique order. Otherwise you will get an unpredictable subset of the query's rows'; different LIMIT/OFFSET values 'will give inconsistent results unless you enforce a predictable result ordering with ORDER BY'."
    },
    {
      "cite": "Author's scenario (REQ-333)",
      "checkedAt": "2026-11-17",
      "note": "Every organization, person, count and deadline is invented teaching data; tool output is an authored rendering in the tool style."
    }
  ],
  "brief": {
    "situation": "You maintain the member export at Brightwater Credit Union (fictional). It sends 48,000 members to the mailing house in pages of 1,000 with LIMIT and OFFSET. Last month some members were mailed twice and others not at all, though the total was right. The next export goes at 11:00. It is 10:05.",
    "handover": [
      "The query has no ORDER BY; it 'came out in id order' when it was written."
    ],
    "howItWorks": [
      "Pick a step from the action list: look, change, check or ship. Nothing you pick is typed or executed: every step shows an authored result.",
      "Each step takes working minutes, and the clock moves by the minutes it takes. The deadline runs on the same clock.",
      "Shipping is final for this case. Afterwards you record what you found and explain your reasoning."
    ]
  },
  "clock": {
    "start": "10:05",
    "tick": "1min",
    "maxDuration": "150min",
    "calendar": "clock"
  },
  "params": {
    "deadline": {
      "value": 3000,
      "unit": "s",
      "source": {
        "cite": "Author's scenario (REQ-333)",
        "checkedAt": "2026-11-17",
        "note": "The deadline is an invented teaching value."
      }
    }
  },
  "state": {
    "busy": {
      "type": "bool",
      "init": false
    },
    "closedAt": {
      "type": "time",
      "init": null
    },
    "documented": {
      "type": "bool",
      "init": false
    },
    "fix": {
      "type": "enum",
      "values": [
        "bug",
        "pk",
        "date",
        "one"
      ],
      "init": "bug"
    },
    "lookAt": {
      "type": "time",
      "init": null
    },
    "changedAt": {
      "type": "time",
      "init": null
    },
    "lastChangeAt": {
      "type": "time",
      "init": null
    },
    "testAt": {
      "type": "time",
      "init": null
    },
    "testPassed": {
      "type": "bool",
      "init": false
    },
    "rowsAlteredOutsideFix": {
      "type": "number",
      "init": 0,
      "min": 0,
      "max": 1000000
    },
    "sentAs": {
      "type": "enum",
      "values": [
        "unsent",
        "wrong",
        "right"
      ],
      "init": "unsent"
    },
    "sentAt": {
      "type": "time",
      "init": null
    },
    "lockedAt": {
      "type": "time",
      "init": null
    },
    "causeDoc": {
      "type": "enum",
      "values": [
        "unset",
        "c0",
        "c1",
        "c2"
      ],
      "init": "unset"
    },
    "checkDoc": {
      "type": "enum",
      "values": [
        "unset",
        "k0",
        "k1",
        "k2"
      ],
      "init": "unset"
    }
  },
  "derived": {
    "fixed": {
      "expr": "(fix == \"pk\")"
    },
    "correct": {
      "expr": "(fix == \"pk\" or fix == \"date\")"
    },
    "sent": {
      "expr": "sentAs != \"unsent\""
    },
    "sentSec": {
      "expr": "not isNull(sentAt) ? timeAt(sentAt) : -1"
    },
    "lookedFirst": {
      "expr": "not isNull(lookAt) and (isNull(changedAt) or timeAt(lookAt) <= timeAt(changedAt))"
    },
    "checkedCurrent": {
      "expr": "testPassed and not isNull(testAt) and timeAt(testAt) >= timeAt(lastChangeAt)"
    }
  },
  "processes": [],
  "phases": {
    "work": {
      "label": "Working the problem",
      "clock": "turns",
      "actions": [
        "look",
        "change",
        "check",
        "ship",
        "wait",
        "finish"
      ]
    },
    "report": {
      "label": "Record",
      "clock": "stopped",
      "actions": [
        "document"
      ]
    }
  },
  "initialPhase": "work",
  "actions": {
    "look": {
      "label": "Export all pages and count distinct member_id against rows sent",
      "group": "Look",
      "available": "not busy",
      "why": "Wait for the running step to finish.",
      "effects": [
        {
          "if": "isNull(lookAt)",
          "then": [
            {
              "set": "lookAt",
              "to": "t"
            }
          ]
        },
        {
          "if": "fixed",
          "then": [
            {
              "output": "rows sent 48,000; distinct 48,000; no member missing"
            }
          ],
          "else": [
            {
              "output": "rows sent 48,000; distinct member_id 46,860\n1,140 ids appear twice; 1,140 active members missing"
            }
          ]
        },
        {
          "if": "fixed",
          "then": [
            {
              "finding": "Each page is a fixed slice of a unique order."
            }
          ],
          "else": [
            {
              "finding": "Without ORDER BY each page is an unpredictable subset, and plans differ by OFFSET, so pages overlap."
            }
          ]
        },
        {
          "set": "busy",
          "to": "true"
        },
        {
          "schedule": "work",
          "after": "4min"
        }
      ]
    },
    "change": {
      "label": "Change the paging",
      "group": "Change",
      "available": "not busy",
      "why": "Wait for the running step to finish.",
      "params": [
        {
          "id": "f",
          "kind": "choice",
          "label": "Change",
          "options": [
            {
              "value": "pk",
              "label": "ORDER BY member_id (the primary key, unique) before LIMIT/OFFSET"
            },
            {
              "value": "date",
              "label": "ORDER BY joined_on"
            },
            {
              "value": "one",
              "label": "Drop paging and send one 48,000-row file"
            }
          ]
        }
      ],
      "effects": [
        {
          "if": "isNull(changedAt)",
          "then": [
            {
              "set": "changedAt",
              "to": "t"
            }
          ]
        },
        {
          "set": "lastChangeAt",
          "to": "t"
        },
        {
          "set": "fix",
          "to": "f"
        },
        {
          "set": "testPassed",
          "to": "false"
        },
        {
          "log": "Changed: {f}.",
          "kind": "act"
        },
        {
          "set": "busy",
          "to": "true"
        },
        {
          "schedule": "work",
          "after": "5min"
        }
      ]
    },
    "check": {
      "label": "Run the export twice and compare the distinct ids and page contents",
      "group": "Check",
      "available": "not busy",
      "why": "Wait for the running step to finish.",
      "effects": [
        {
          "set": "testAt",
          "to": "t"
        },
        {
          "cases": [
            {
              "when": "fix == \"pk\"",
              "then": [
                {
                  "set": "testPassed",
                  "to": "true"
                },
                {
                  "output": "48 pages; 48,000 distinct ids; repeat run identical\n2 passed"
                }
              ]
            },
            {
              "when": "fix == \"date\"",
              "then": [
                {
                  "set": "testPassed",
                  "to": "true"
                },
                {
                  "output": "48,000 distinct this run; tie group on 2019-07-01 ordered differently on rerun\n2 passed (not unique: repeat runs can differ)"
                }
              ]
            },
            {
              "when": "fix == \"one\"",
              "then": [
                {
                  "output": "upload rejected: file exceeds 1,000 rows\n1 failed"
                }
              ]
            },
            {
              "when": "true",
              "then": [
                {
                  "output": "distinct 46,860; page contents differ between runs\n1 failed"
                }
              ]
            }
          ]
        },
        {
          "set": "busy",
          "to": "true"
        },
        {
          "schedule": "work",
          "after": "3min"
        }
      ]
    },
    "ship": {
      "label": "Send the export to the mailing house",
      "group": "Ship",
      "available": "not busy and not sent",
      "why": "Already done.",
      "effects": [
        {
          "set": "sentAs",
          "to": "correct ? \"right\" : \"wrong\""
        },
        {
          "set": "sentAt",
          "to": "t"
        },
        {
          "if": "correct",
          "then": [
            {
              "output": "Sent: 48,000 members, each once."
            }
          ],
          "else": [
            {
              "output": "Sent: duplicates and gaps again."
            }
          ]
        },
        {
          "set": "busy",
          "to": "true"
        },
        {
          "schedule": "work",
          "after": "2min"
        }
      ]
    },
    "wait": {
      "label": "Wait 10 minutes",
      "group": "Wait",
      "available": "not busy",
      "why": "Wait for the running step to finish.",
      "effects": [
        {
          "log": "You wait 10 minutes.",
          "kind": "act"
        },
        {
          "set": "busy",
          "to": "true"
        },
        {
          "schedule": "work",
          "after": "10min"
        }
      ]
    },
    "finish": {
      "label": "Done: record what you found",
      "group": "Close",
      "available": "not busy",
      "why": "Wait for the running step to finish.",
      "effects": [
        {
          "cancel": "work"
        },
        {
          "set": "busy",
          "to": "false"
        },
        {
          "set": "closedAt",
          "to": "t"
        },
        {
          "log": "You stop and write it up.",
          "kind": "act"
        },
        {
          "phase": "report"
        }
      ]
    },
    "document": {
      "label": "Record the cause and the check",
      "group": "Report",
      "available": "not documented",
      "why": "Done.",
      "params": [
        {
          "id": "record",
          "kind": "form",
          "label": "Record",
          "fields": [
            {
              "id": "cause",
              "label": "Why pages overlapped",
              "options": [
                {
                  "value": "c0",
                  "label": "LIMIT/OFFSET without ORDER BY returns an unpredictable subset for each page"
                },
                {
                  "value": "c1",
                  "label": "The members table has duplicate rows"
                },
                {
                  "value": "c2",
                  "label": "The mailing house merged files"
                }
              ]
            },
            {
              "id": "check",
              "label": "How you know it is right",
              "options": [
                {
                  "value": "k0",
                  "label": "Distinct ids equal rows sent, and two runs give identical pages"
                },
                {
                  "value": "k1",
                  "label": "The file is the right size"
                },
                {
                  "value": "k2",
                  "label": "Not checked"
                }
              ]
            }
          ]
        }
      ],
      "effects": [
        {
          "set": "causeDoc",
          "to": "cause"
        },
        {
          "set": "checkDoc",
          "to": "check"
        },
        {
          "log": "Recorded: cause {cause}, check {check}.",
          "kind": "act"
        },
        {
          "set": "documented",
          "to": "true"
        }
      ]
    }
  },
  "timers": {
    "work": {
      "label": "Step running",
      "wait": {
        "skipLabel": "Let the step finish"
      },
      "instances": "one",
      "source": {
        "cite": "Author's scenario (REQ-333)",
        "checkedAt": "2026-11-17",
        "note": "Working minutes per step are invented teaching values."
      },
      "effects": [
        {
          "set": "busy",
          "to": "false"
        }
      ]
    }
  },
  "triggers": [
    {
      "id": "lock",
      "when": "t >= deadline and not sent",
      "mode": "once",
      "interruptsSkip": true,
      "effects": [
        {
          "set": "lockedAt",
          "to": "t"
        },
        {
          "log": "11:00: the export window closed.",
          "kind": "alarm"
        }
      ]
    },
    {
      "id": "writeUp",
      "when": "phase == \"report\"",
      "mode": "once",
      "effects": [
        {
          "reason": "writeup"
        }
      ]
    }
  ],
  "reasoning": {
    "writeup": {
      "question": "For marketing: why some members got two statements, what you changed, and how you know.",
      "pausesClock": true,
      "parts": [
        {
          "label": "Why",
          "criteria": "SQL promises no row order without ORDER BY; LIMIT/OFFSET then slices an unpredictable order, and the plan can change with the offset.",
          "modelAnswer": "No ORDER BY under LIMIT."
        },
        {
          "label": "What you changed",
          "criteria": "ORDER BY a unique key (the primary key) so pages are disjoint; a non-unique column leaves ties free to move; one big file breaks the receiver's limit.",
          "modelAnswer": "ORDER BY member_id."
        },
        {
          "label": "How you know",
          "criteria": "Distinct ids equal rows sent, and a second run gives identical pages.",
          "modelAnswer": "48,000 distinct, twice."
        }
      ]
    }
  },
  "outcome": {
    "profile": "data",
    "thresholds": {
      "deliverWindow": {
        "value": 3000,
        "source": {
          "cite": "Author's scenario (REQ-333)",
          "checkedAt": "2026-11-17",
          "note": "The case's deadline; invented."
        }
      }
    },
    "noProgress": {
      "when": "documented and not sent",
      "class": "recovered",
      "rationale": "Shipping nothing ships nothing wrong, but the deadline passes without the fix.",
      "source": {
        "cite": "Author's scenario (REQ-333)",
        "checkedAt": "2026-11-17",
        "note": "An invented teaching scenario."
      }
    }
  },
  "endings": {
    "wrongSent": {
      "label": "Wrong mailing sent",
      "class": "harm",
      "terminal": true,
      "when": "documented and sentAs == \"wrong\"",
      "narrative": "Some members get two statements and some get none again."
    },
    "notSent": {
      "label": "Nothing shipped",
      "class": "recovered",
      "terminal": true,
      "when": "documented and not sent",
      "narrative": "No duplicates, but no statements this cycle."
    },
    "right": {
      "label": "Right, checked, on time",
      "class": "target",
      "terminal": true,
      "when": "documented and sentAs == \"right\" and fixed and sentSec <= deadline and checkedCurrent and lookedFirst",
      "narrative": "Every active member gets one statement."
    },
    "gaps": {
      "label": "Right, with gaps",
      "class": "recovered",
      "terminal": true,
      "when": "documented",
      "narrative": "The result is right, but it went late, unchecked, before you looked, or with a weaker fix."
    },
    "time_up": {
      "label": "Time up",
      "class": "recovered",
      "terminal": true,
      "narrative": "The case reached its time limit with nothing recorded."
    }
  },
  "endingOrder": [
    "wrongSent",
    "notSent",
    "right",
    "gaps"
  ],
  "scoring": {
    "criteria": [
      {
        "id": "looked",
        "label": "Counted duplicates across pages before changing the query",
        "weight": 1,
        "critical": true,
        "rows": [
          {
            "when": "lookedFirst",
            "score": "met",
            "why": "Looked first."
          },
          {
            "when": "not isNull(lookAt)",
            "score": "partial",
            "why": "Looked only after a change."
          },
          {
            "when": "true",
            "score": "missed",
            "why": "Never looked before acting."
          }
        ]
      },
      {
        "id": "fixed",
        "label": "Paged over a unique order (the primary key)",
        "weight": 1,
        "critical": true,
        "rows": [
          {
            "when": "fixed",
            "score": "met",
            "why": "A unique ORDER BY under LIMIT/OFFSET."
          },
          {
            "when": "fix == \"date\"",
            "score": "partial",
            "why": "joined_on has ties (312 members joined the same day), so tied rows can still move between pages."
          },
          {
            "when": "true",
            "score": "missed",
            "why": "{fix == \"one\" ? \"The mailing house accepts at most 1,000 rows per file; the upload is rejected.\" : \"Pages still have no defined order.\"}"
          }
        ]
      },
      {
        "id": "shipped",
        "label": "Shipped nothing wrong",
        "weight": 1,
        "critical": true,
        "rows": [
          {
            "when": "sentAs != \"wrong\"",
            "score": "met",
            "why": "Nothing wrong shipped."
          },
          {
            "when": "true",
            "score": "missed",
            "why": "Shipped a wrong result."
          }
        ]
      },
      {
        "id": "checked",
        "label": "Distinct count and repeat runs matched after the last change, before sending",
        "weight": 1,
        "rows": [
          {
            "when": "checkedCurrent and (not sent or timeAt(testAt) <= sentSec)",
            "score": "met",
            "why": "Checked after the last change, before shipping."
          },
          {
            "when": "not isNull(testAt)",
            "score": "partial",
            "why": "Checked, but it failed or came before a later change."
          },
          {
            "when": "true",
            "score": "missed",
            "why": "Never checked."
          }
        ]
      },
      {
        "id": "note",
        "label": "The record names the cause and the check",
        "weight": 1,
        "rows": [
          {
            "when": "causeDoc == \"c0\" and checkDoc == \"k0\"",
            "score": "met",
            "why": "Cause and check both right."
          },
          {
            "when": "causeDoc == \"c0\" or checkDoc == \"k0\"",
            "score": "partial",
            "why": "Half right."
          },
          {
            "when": "true",
            "score": "missed",
            "why": "Neither is recorded right."
          }
        ]
      }
    ],
    "reasoningCriteria": [
      {
        "moment": "writeup",
        "label": "Written explanation",
        "weight": 1
      }
    ],
    "kpis": [
      {
        "id": "rightK",
        "label": "Right result shipped",
        "value": "sentAs == \"right\" ? 1 : 0",
        "format": "number",
        "expert": "1"
      },
      {
        "id": "altered",
        "label": "Rows changed outside the fix",
        "value": "rowsAlteredOutsideFix",
        "format": "number",
        "expert": "0"
      },
      {
        "id": "sentAtMin",
        "label": "Minutes until shipped",
        "value": "sent ? sentSec / 60 : 0",
        "format": "number",
        "expert": "about 14"
      }
    ],
    "expertPath": [
      {
        "at": "0-4 min",
        "text": "1,140 duplicate ids across pages."
      },
      {
        "at": "4-9 min",
        "text": "ORDER BY member_id."
      },
      {
        "at": "9-12 min",
        "text": "Distinct equals sent; reruns identical."
      },
      {
        "at": "12-14 min",
        "text": "Send."
      }
    ],
    "debrief": {
      "right": {
        "headline": "Good: order before you page",
        "body": "LIMIT without a unique ORDER BY returns whichever rows the plan finds first. Order by a key, then slice."
      },
      "gaps": {
        "headline": "Right, with gaps",
        "body": "The result is right; it went late, unchecked, before you looked, or with a weaker fix than the cause called for."
      },
      "wrongSent": {
        "headline": "Wrong mailing",
        "body": "A file the receiver rejects, or an order with ties, does not make the pages stable."
      },
      "notSent": {
        "headline": "Nothing shipped",
        "body": "Safe, but the deadline passed without the fix."
      },
      "time_up": {
        "headline": "Time up",
        "body": "Nothing was recorded before the case's limit."
      }
    },
    "modelReasoning": "Right total, wrong members, means overlapping pages. The query pages with LIMIT/OFFSET and no ORDER BY, so each page is an unpredictable subset and the plan can differ by offset. Order by a unique key, member_id, before LIMIT/OFFSET. joined_on has ties, so tied rows can still move; one large file exceeds the mailing house's limit. Check that distinct ids equal rows sent and that a rerun is identical."
  }
}

          "id": "code",
          "label": "branch_activity.sql",
          "language": "SQL",
          "lines": [
            {
              "id": "c0",
              "text": "SELECT b.name,"
            },
            {
              "id": "c1",
              "text": "  count(*) AS loans, sum(l.fine) AS fines",
              "when": "fix == \"bug\"",
              "mark": "not isNull(lookAt) ? \"error\" : \"none\""
            },
            {
              "id": "c2",
              "text": "  count(l.loan_id) AS loans, coalesce(sum(l.fine), 0) AS fines",
              "when": "fix == \"col\"",
              "mark": "\"changed\""
            },
            {
              "id": "c3",
              "text": "  count(*) AS loans, coalesce(sum(l.fine), 0) AS fines",
              "when": "fix == \"coal\"",
              "mark": "\"warning\""
            },
            {
              "id": "c4",
              "text": "  count(*) AS loans, sum(l.fine) AS fines",
              "when": "fix == \"having\"",
              "mark": "\"warning\""
            },
            {
              "id": "c5",
              "text": "FROM branches b LEFT JOIN loans l ON l.branch_id = b.id AND l.week = :week"
            },
            {
              "id": "c6",
              "text": "GROUP BY b.name;"
            },
            {
              "id": "c7",
              "text": "HAVING count(*) > 1;",
              "when": "fix == \"having\"",
              "mark": "\"warning\""
            }
          ]
        }
      ],

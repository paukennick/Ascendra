      "pausesClock": true,
      "parts": [
        {
          "label": "Why",
          "criteria": "UNION removes duplicate rows as DISTINCT does; two refunds of the same amount to the same account on the same day are identical rows.",
          "modelAnswer": "UNION collapsed equal payouts."
        },
        {
          "label": "What you changed",
          "criteria": "UNION ALL, plus a source and id column so rows are distinct by identity; more DISTINCT removes more payouts.",
          "modelAnswer": "UNION ALL with source ids."
        },
        {
          "label": "How you know",

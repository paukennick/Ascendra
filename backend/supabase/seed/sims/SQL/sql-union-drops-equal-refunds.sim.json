      "code": [
        {
          "id": "code",
          "label": "payouts.sql",
          "language": "SQL",
          "lines": [
            {
              "id": "c0",
              "text": "SELECT account, amount, paid_on FROM refunds WHERE paid_on = :day"
            },
            {
              "id": "c1",
              "text": "UNION",
              "when": "fix == \"bug\"",
              "mark": "not isNull(lookAt) ? \"error\" : \"none\""
            },
            {
              "id": "c2",
              "text": "UNION ALL"
            },
            {
              "id": "c3",
              "text": "UNION ALL",
              "when": "fix == \"allid\"",
              "mark": "\"changed\""
            },
            {
              "id": "c4",
              "text": "SELECT account, amount, paid_on FROM commissions WHERE paid_on = :day;"
            },
            {
              "id": "c5",
              "text": "(both selects also return source and source_id)",
              "when": "fix == \"allid\"",
              "mark": "\"changed\""
            },
            {
              "id": "c6",
              "text": "(both selects add DISTINCT ON (account, amount))",
              "when": "fix == \"dist\"",
              "mark": "\"warning\""
            },
            {
              "id": "c7",
              "text": "UNION",
              "when": "fix == \"dist\"",
              "mark": "\"warning\""
            }
          ]
        }
      ],

    "debrief": {
      "right": {
        "headline": "Good: duplicates can be real",
        "body": "UNION means set union: identical rows become one. When two rows are two payments, use UNION ALL and keep an id."
      },
      "gaps": {
        "headline": "Right, with gaps",
        "body": "The result is right; it went late, unchecked, before you looked, or with a weaker fix than the cause called for."
      },
      "wrongSent": {
        "headline": "Payouts missing",
        "body": "Adding DISTINCT treats real payments as duplicates."
      },
      "notSent": {
        "headline": "Nothing shipped",
        "body": "Safe, but the deadline passed without the fix."
      },
      "time_up": {
        "headline": "Time up",
        "body": "Nothing was recorded before the case's limit."
      }
    },
    "modelReasoning": "Missing payouts always duplicate another in account, amount and date, which is what UNION removes: it eliminates duplicate rows the way DISTINCT does. Two refunds of 49.00 to one account on one day are two payments. Use UNION ALL, and carry the source and its id so each line is traceable. Reconcile count and total with the sources."
  }

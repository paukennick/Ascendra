  "derived": {
    "decided": {
      "expr": "decision != \"none\""
    },
    "decidedSec": {
      "expr": "not isNull(decidedAt) ? timeAt(decidedAt) : -1"
    },
    "tampered": {
      "expr": "not isNull(tamperedAt)"
    },
    "m21": {
      "expr": "(not isNull(fixedAt) and timeAt(fixedAt) <= 900) ? ((not isNull(tamperedAt) and timeAt(tamperedAt) <= 900) ? 503.1 : 502.0) : (not isNull(tamperedAt) and timeAt(tamperedAt) <= 900) ? 501.3 : 500.1"
    },
    "m22": {
      "expr": "(not isNull(fixedAt) and timeAt(fixedAt) <= 1800) ? ((not isNull(tamperedAt) and timeAt(tamperedAt) <= 1800) ? 504.0 : 502.3) : (not isNull(tamperedAt) and timeAt(tamperedAt) <= 1800) ? 503.9 : 499.8"
    },
    "p21": {
      "expr": "(not isNull(fixedAt) and timeAt(fixedAt) <= 900) ? 0 : 0.4"
    },
    "p22": {
      "expr": "(not isNull(fixedAt) and timeAt(fixedAt) <= 1800) ? 0 : 0.6"
    },
    "causeFirst": {
      "expr": "not isNull(askedAt) and (isNull(fixedAt) or timeAt(askedAt) <= timeAt(fixedAt)) and not tampered"
    }
  },

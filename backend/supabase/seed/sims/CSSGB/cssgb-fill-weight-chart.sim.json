  "initialPhase": "work",
  "actions": {
    "setChart": {
      "label": "Change the chart used for fill weight",
      "group": "Chart",
      "available": "not busy",
      "why": "Wait for the running step to finish.",
      "params": [
        {
          "id": "kind",
          "kind": "choice",
          "label": "Chart",
          "options": [
            {
              "value": "p",
              "label": "p chart: share of bags under 500 g"
            },
            {
              "value": "c",
              "label": "c chart: count of defects per subgroup"
            },
            {
              "value": "xbar",
              "label": "X-bar and R: mean and range of the 5 weights"
            }
          ]
        }
      ],
      "effects": [
        {
          "set": "chartType",
          "to": "kind"
        },
        {
          "if": "isNull(chartSetAt)",
          "then": [
            {
              "set": "chartSetAt",
              "to": "t"
            }
          ]
        },
        {
          "set": "runSeen",
          "to": "false"
        },
        {
          "log": "Chart for fill weight: {kind}.",
          "kind": "act"
        },
        {
          "set": "busy",
          "to": "true"
        },
        {
          "schedule": "work",
          "after": "3min"
        }
      ]
    },
    "rules": {
      "label": "Apply the WECO run rules to the chart",

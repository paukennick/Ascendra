          "text": "18:00: the winter timetable launched with the planner as it stood.",
          "when": "not isNull(lockedAt)",
          "severity": "error"
        }
      ],
      "charts": [],
      "tables": [],
      "code": [
        {
          "id": "code",
          "label": "planner.py",
          "language": "Python",
          "lines": [
            {
              "id": "c0",
              "text": "def find(start, goal):"
            },
            {
              "id": "c1",
              "text": "    stack = [[start]]                   # depth-first",
              "when": "fix == \"bug\"",
              "mark": "not isNull(lookAt) ? \"error\" : \"none\""
            },
            {
              "id": "c2",
              "text": "    path = stack.pop(); ... return the first path that reaches goal",
              "when": "fix == \"bug\"",
              "mark": "not isNull(lookAt) ? \"error\" : \"none\""
            },
            {
              "id": "c3",
              "text": "    queue = deque([start]); parent = {start: None}   # breadth-first, mark on enqueue",
              "when": "fix == \"bfs\"",
              "mark": "\"changed\""
            },
            {
              "id": "c4",
              "text": "    ... first time goal is dequeued, rebuild the path from parent",
              "when": "fix == \"bfs\"",
              "mark": "\"changed\""
            },
            {
              "id": "c5",
              "text": "    try every path depth-first and keep the shortest"
            },
            {
              "id": "c6",
              "text": "    heap with Dijkstra, every edge weight 1",
              "when": "fix == \"dij\"",
              "mark": "\"warning\""
            }
          ]
        }
      ],
      "meters": [
        {
          "id": "due",
          "label": "Launch",
          "value": "18:00"
        }
      ]
    }
  },

      "flags": [
        {
          "id": "ask",
          "label": "Customer service lead, Owen Clarke",
          "text": "The planner told a rider to take seven buses to a stop one transfer away. The new planner launches with the winter timetable at 18:00.",
          "when": "true",
          "severity": "info"
        },
        {
          "id": "seen",
          "label": "Pattern",

      "type": "time",
      "init": null
    },
    "testAt": {
      "type": "time",
      "init": null
    },
    "testPassed": {
      "type": "bool",
      "init": false
    },
    "rowsAlteredOutsideFix": {
      "type": "number",
      "init": 0,
      "min": 0,
      "max": 1000000
    },
    "sentAs": {
      "type": "enum",
      "values": [
        "unsent",
        "wrong",
        "right"
      ],
      "init": "unsent"
    },
    "sentAt": {
      "type": "time",
      "init": null
    },
    "lockedAt": {
      "type": "time",
      "init": null
    },
    "causeDoc": {
      "type": "enum",
      "values": [
        "unset",
        "c0",
        "c1",
        "c2"
      ],
      "init": "unset"
    },
    "checkDoc": {
      "type": "enum",
      "values": [
        "unset",
        "k0",
        "k1",
        "k2"
      ],
      "init": "unset"
    }
  },
  "derived": {
    "fixed": {
      "expr": "(fix == \"full\")"
    },
    "correct": {
      "expr": "(fix == \"full\" or fix == \"seed\")"
    },
    "sent": {
      "expr": "sentAs != \"unsent\""
    },
    "sentSec": {
      "expr": "not isNull(sentAt) ? timeAt(sentAt) : -1"
    },
    "lookedFirst": {
      "expr": "not isNull(lookAt) and (isNull(changedAt) or timeAt(lookAt) <= timeAt(changedAt))"
    },
    "checkedCurrent": {
      "expr": "testPassed and not isNull(testAt) and timeAt(testAt) >= timeAt(lastChangeAt)"
    }
  },
  "processes": [],
  "phases": {
    "work": {
      "label": "Working the problem",
      "clock": "turns",
      "actions": [
        "look",
        "change",
        "check",
        "ship",
        "wait",
        "finish"
      ]
    },
    "report": {
      "label": "Record",
      "clock": "stopped",
      "actions": [
        "document"
      ]
    }
  },
  "initialPhase": "work",
  "actions": {
    "look": {
      "label": "Run the script twice and compare samples; diff raw.csv with the housing system export",
      "group": "Look",
      "available": "not busy",
      "why": "Wait for the running step to finish.",
      "effects": [
        {
          "if": "isNull(lookAt)",
          "then": [
            {
              "set": "lookAt",
              "to": "t"
            }
          ]
        },
        {
          "if": "fixed",
          "then": [
            {
              "output": "two runs: identical 400 households; raw/ matches the export"
            }
          ],
          "else": [
            {
              "output": "run 1 and run 2 share 39 of 400 households\nraw.csv: 4,612 rows; system export: 4,912 rows"
            }
          ]
        },
        {
          "if": "fixed",
          "then": [
            {
              "finding": "Same inputs, same steps, same sample."
            }
          ],
          "else": [
            {
              "finding": "The sample is unseeded, and the cleaning step overwrote the raw data, so nobody can rerun from the start."
            }
          ]
        },
        {
          "set": "busy",
          "to": "true"
        },
        {
          "schedule": "work",
          "after": "4min"
        }
      ]
    },
    "change": {
      "label": "Change the analysis setup",
      "group": "Change",
      "available": "not busy",
      "why": "Wait for the running step to finish.",
      "params": [
        {
          "id": "f",
          "kind": "choice",
          "label": "Change",
          "options": [
            {
              "value": "full",
              "label": "Restore raw data read-only, write cleaned data elsewhere, seed a default_rng Generator, pin versions, one run-all command"
            },
            {
              "value": "seed",
              "label": "Add np.random.seed(1) and rerun on the current raw.csv"
            },
            {
              "value": "send",
              "label": "Send the auditor last week's sample file"
            }
          ]
        }
      ],
      "effects": [
        {
          "if": "isNull(changedAt)",
          "then": [
            {
              "set": "changedAt",
              "to": "t"
            }
          ]
        },
        {
          "set": "lastChangeAt",
          "to": "t"
        },
        {
          "set": "fix",
          "to": "f"
        },
        {
          "set": "testPassed",
          "to": "false"
        },
        {
          "log": "Changed: {f}.",
          "kind": "act"
        },
        {
          "set": "busy",
          "to": "true"
        },
        {
          "schedule": "work",
          "after": "5min"
        }
      ]
    },
    "check": {
      "label": "Have the auditor run the run-all command on a clean machine",
      "group": "Check",
      "available": "not busy",
      "why": "Wait for the running step to finish.",
      "effects": [
        {
          "set": "testAt",
          "to": "t"
        },
        {
          "cases": [
            {
              "when": "fix == \"full\"",
              "then": [
                {
                  "set": "testPassed",
                  "to": "true"
                },
                {
                  "output": "auditor's machine reproduces 400 households and the estimate exactly\n3 passed"
                }
              ]
            },
            {
              "when": "fix == \"seed\"",
              "then": [
                {
                  "set": "testPassed",
                  "to": "true"
                },
                {
                  "output": "repeatable sample; still 4,612 rows, not 4,912\n2 passed, 1 failed"
                }
              ]
            },
            {
              "when": "fix == \"send\"",
              "then": [
                {
                  "output": "auditor cannot regenerate sample.csv\n1 failed"
                }
              ]
            },
            {
              "when": "true",
              "then": [
                {
                  "output": "different sample; different estimate\n1 failed"
                }
              ]
            }
          ]
        },
        {
          "set": "busy",
          "to": "true"
        },
        {
          "schedule": "work",
          "after": "3min"
        }
      ]
    },
    "ship": {
      "label": "Submit the analysis for audit sign-off",
      "group": "Ship",
      "available": "not busy and not sent",
      "why": "Already done.",
      "effects": [
        {
          "set": "sentAs",
          "to": "correct ? \"right\" : \"wrong\""
        },
        {
          "set": "sentAt",
          "to": "t"
        },
        {
          "if": "correct",
          "then": [
            {
              "output": "Signed off: reproduced independently."
            }
          ],
          "else": [
            {
              "output": "Submitted: not reproducible."
            }
          ]
        },
        {
          "set": "busy",
          "to": "true"
        },
        {
          "schedule": "work",
          "after": "2min"
        }
      ]
    },
    "wait": {
      "label": "Wait 10 minutes",
      "group": "Wait",
      "available": "not busy",
      "why": "Wait for the running step to finish.",
      "effects": [
        {
          "log": "You wait 10 minutes.",
          "kind": "act"
        },
        {
          "set": "busy",
          "to": "true"
        },
        {
          "schedule": "work",
          "after": "10min"
        }
      ]
    },
    "finish": {
      "label": "Done: record what you found",
      "group": "Close",
      "available": "not busy",
      "why": "Wait for the running step to finish.",
      "effects": [
        {
          "cancel": "work"
        },
        {
          "set": "busy",
          "to": "false"
        },
        {
          "set": "closedAt",
          "to": "t"
        },
        {
          "log": "You stop and write it up.",
          "kind": "act"
        },
        {
          "phase": "report"
        }
      ]
    },
    "document": {
      "label": "Record the cause and the check",
      "group": "Report",
      "available": "not documented",
      "why": "Done.",
      "params": [
        {
          "id": "record",
          "kind": "form",
          "label": "Record",
          "fields": [
            {
              "id": "cause",
              "label": "Why the auditor could not reproduce it",
              "options": [
                {
                  "value": "c0",
                  "label": "The sample was unseeded and the raw file had been overwritten by the cleaning step"
                },
                {
                  "value": "c1",
                  "label": "The auditor used Excel"
                },
                {
                  "value": "c2",
                  "label": "The survey changed"
                }
              ]
            },
            {
              "id": "check",
              "label": "How you know it is reproducible",
              "options": [
                {
                  "value": "k0",
                  "label": "The auditor's clean-machine run gives the same sample and estimate"
                },
                {
                  "value": "k1",
                  "label": "My rerun matches"
                },
                {
                  "value": "k2",
                  "label": "Not checked"
                }
              ]
            }
          ]
        }
      ],
      "effects": [
        {
          "set": "causeDoc",
          "to": "cause"
        },
        {
          "set": "checkDoc",
          "to": "check"
        },
        {
          "log": "Recorded: cause {cause}, check {check}.",
          "kind": "act"
        },
        {
          "set": "documented",
          "to": "true"
        }
      ]
    }
  },
  "timers": {
    "work": {
      "label": "Step running",
      "wait": {
        "skipLabel": "Let the step finish"
      },
      "instances": "one",
      "source": {
        "cite": "Author's scenario (REQ-333)",
        "checkedAt": "2026-11-17",
        "note": "Working minutes per step are invented teaching values."
      },
      "effects": [
        {
          "set": "busy",
          "to": "false"
        }
      ]
    }
  },
  "triggers": [
    {
      "id": "lock",
      "when": "t >= deadline and not sent",

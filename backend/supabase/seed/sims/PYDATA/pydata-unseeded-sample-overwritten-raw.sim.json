    {
      "id": "writeUp",
      "when": "phase == \"report\"",
      "mode": "once",
      "effects": [
        {
          "reason": "writeup"
        }
      ]
    }
  ],
  "reasoning": {
    "writeup": {
      "question": "For the auditor: why it did not reproduce, what you changed, and how you know.",
      "pausesClock": true,
      "parts": [
        {
          "label": "Why",
          "criteria": "Unseeded sampling draws fresh entropy each run, and overwriting raw.csv destroyed the starting point.",
          "modelAnswer": "No seed, no raw data."
        },
        {
          "label": "What you changed",
          "criteria": "Raw data restored and read-only, cleaned data written elsewhere, default_rng with a fixed seed, pinned versions, and one run-all command; a seed alone still starts from changed data.",
          "modelAnswer": "Raw read-only, seeded Generator, pins."
        },
        {
          "label": "How you know",
          "criteria": "The auditor's clean run reproduces sample and estimate.",
          "modelAnswer": "Identical on a clean machine."
        }
      ]
    }
  },
  "outcome": {
    "profile": "data",
    "thresholds": {
      "deliverWindow": {
        "value": 3000,
        "source": {
          "cite": "Author's scenario (REQ-333)",
          "checkedAt": "2026-11-17",
          "note": "The case's deadline; invented."
        }
      }
    },
    "noProgress": {
      "when": "documented and not sent",
      "class": "recovered",
      "rationale": "Shipping nothing ships nothing wrong, but the deadline passes without the fix.",
      "source": {
        "cite": "Author's scenario (REQ-333)",
        "checkedAt": "2026-11-17",
        "note": "An invented teaching scenario."
      }
    }
  },
  "endings": {
    "wrongSent": {
      "label": "Unreproducible analysis submitted",
      "class": "harm",
      "terminal": true,
      "when": "documented and sentAs == \"wrong\"",
      "narrative": "The survey estimate fails audit."
    },
    "notSent": {
      "label": "Nothing shipped",
      "class": "recovered",
      "terminal": true,
      "when": "documented and not sent",
      "narrative": "Nothing wrong submitted, but sign-off slipped."
    },
    "right": {
      "label": "Right, checked, on time",
      "class": "target",
      "terminal": true,
      "when": "documented and sentAs == \"right\" and fixed and sentSec <= deadline and checkedCurrent and lookedFirst",
      "narrative": "The auditor reproduces the sample and the estimate independently."
    },
    "gaps": {
      "label": "Right, with gaps",
      "class": "recovered",
      "terminal": true,
      "when": "documented",
      "narrative": "The result is right, but it went late, unchecked, before you looked, or with a weaker fix."
    },
    "time_up": {
      "label": "Time up",
      "class": "recovered",
      "terminal": true,
      "narrative": "The case reached its time limit with nothing recorded."
    }
  },
  "endingOrder": [
    "wrongSent",
    "notSent",
    "right",
    "gaps"
  ],
  "scoring": {
    "criteria": [
      {
        "id": "looked",
        "label": "Compared two runs and the raw file before changing anything",
        "weight": 1,
        "critical": true,
        "rows": [
          {
            "when": "lookedFirst",
            "score": "met",
            "why": "Looked first."
          },
          {
            "when": "not isNull(lookAt)",
            "score": "partial",
            "why": "Looked only after a change."
          },
          {
            "when": "true",
            "score": "missed",
            "why": "Never looked before acting."
          }
        ]
      },
      {
        "id": "fixed",
        "label": "Made the analysis rerunnable from raw data",
        "weight": 1,
        "critical": true,
        "rows": [
          {
            "when": "fixed",
            "score": "met",
            "why": "Read-only raw data, a seeded Generator, pinned versions and a run-all step."
          },
          {
            "when": "fix == \"seed\"",
            "score": "partial",
            "why": "Sampling repeats now, but from the already-cleaned file, and the report's numbers still can't be traced to the export."
          },
          {
            "when": "true",
            "score": "missed",
            "why": "{fix == \"send\" ? \"Shows a result, not how it was made.\" : \"The analysis still cannot be rerun from raw data.\"}"
          }
        ]
      },
      {
        "id": "shipped",
        "label": "Shipped nothing wrong",
        "weight": 1,
        "critical": true,
        "rows": [
          {
            "when": "sentAs != \"wrong\"",
            "score": "met",
            "why": "Nothing wrong shipped."
          },
          {
            "when": "true",
            "score": "missed",
            "why": "Shipped a wrong result."
          }
        ]
      },
      {
        "id": "checked",
        "label": "A clean-machine run reproduced the results after the last change, before sign-off",
        "weight": 1,
        "rows": [
          {
            "when": "checkedCurrent and (not sent or timeAt(testAt) <= sentSec)",
            "score": "met",
            "why": "Checked after the last change, before shipping."
          },
          {
            "when": "not isNull(testAt)",
            "score": "partial",
            "why": "Checked, but it failed or came before a later change."
          },
          {
            "when": "true",
            "score": "missed",
            "why": "Never checked."
          }
        ]
      },
      {
        "id": "note",
        "label": "The record names the cause and the check",
        "weight": 1,
        "rows": [
          {
            "when": "causeDoc == \"c0\" and checkDoc == \"k0\"",
            "score": "met",
            "why": "Cause and check both right."
          },
          {
            "when": "causeDoc == \"c0\" or checkDoc == \"k0\"",
            "score": "partial",
            "why": "Half right."
          },
          {
            "when": "true",
            "score": "missed",
            "why": "Neither is recorded right."
          }
        ]
      }
    ],
    "reasoningCriteria": [
      {
        "moment": "writeup",
        "label": "Written explanation",
        "weight": 1
      }
    ],
    "kpis": [
      {
        "id": "rightK",
        "label": "Right result shipped",
        "value": "sentAs == \"right\" ? 1 : 0",
        "format": "number",
        "expert": "1"
      },
      {
        "id": "altered",
        "label": "Rows changed outside the fix",
        "value": "rowsAlteredOutsideFix",
        "format": "number",
        "expert": "0"
      },
      {
        "id": "sentAtMin",
        "label": "Minutes until shipped",
        "value": "sent ? sentSec / 60 : 0",
        "format": "number",
        "expert": "about 14"
      }
    ],
    "expertPath": [
      {
        "at": "0-4 min",
        "text": "Runs differ; raw.csv short by 300 rows."
      },
      {
        "at": "4-9 min",
        "text": "Restore raw, seed, pin, run-all."
      },
      {
        "at": "9-12 min",
        "text": "Auditor reproduces."
      },
      {
        "at": "12-14 min",
        "text": "Submit."
      }
    ],
    "debrief": {
      "right": {
        "headline": "Good: rerunnable from the start",
        "body": "Reproducible means another person, on another machine, gets the same result from the raw data."
      },
      "gaps": {
        "headline": "Right, with gaps",
        "body": "The result is right; it went late, unchecked, before you looked, or with a weaker fix than the cause called for."
      },
      "wrongSent": {
        "headline": "Not reproducible",
        "body": "An output file is not an analysis; a seed on altered data reproduces the wrong thing."
      },
      "notSent": {
        "headline": "Nothing shipped",
        "body": "Safe, but the deadline passed without the fix."
      },
      "time_up": {
        "headline": "Time up",

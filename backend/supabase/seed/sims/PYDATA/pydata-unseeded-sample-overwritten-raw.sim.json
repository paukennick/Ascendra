  "slug": "pydata-unseeded-sample-overwritten-raw",
  "title": "The auditor can't get your numbers",
  "screen": {
    "type": "data",
    "level": 1,
    "data": {
      "workspace": "survey/, the household survey sample and estimate, Eastmoor Housing Association (fictional)",
      "flags": [
        {
          "id": "ask",
          "label": "Internal auditor, Carla Mendes",
          "text": "I reran your analysis and got a different sample, and the raw file has 300 fewer rows than your report says. Sign-off is at 17:00.",
          "when": "true",
          "severity": "info"
        },
        {
          "id": "seen",
          "label": "Pattern",
          "text": "Each run draws different households, and the raw file has been changed.",
          "when": "not isNull(lookAt) and not fixed",
          "severity": "warning"
        },
        {
          "id": "lock",
          "label": "Audit sign-off",
          "text": "17:00: the audit sign-off passed.",
          "when": "not isNull(lockedAt)",
          "severity": "error"
        }
      ],
      "charts": [],
      "tables": [],
      "code": [
        {
          "id": "code",
          "label": "survey/run.py",
          "language": "Python",
          "lines": [
            {
              "id": "c0",
              "text": "df = clean(pd.read_csv('raw.csv')); df.to_csv('raw.csv')   # overwrites the raw data",
              "when": "fix == \"bug\"",
              "mark": "not isNull(lookAt) ? \"error\" : \"none\""
            },
            {
              "id": "c1",
              "text": "idx = np.random.choice(len(df), 400, replace=False)   # unseeded",
              "when": "fix == \"bug\"",
              "mark": "not isNull(lookAt) ? \"error\" : \"none\""
            },
            {
              "id": "c2",
              "text": "raw/ re-downloaded and made read-only; cleaned data written to work/clean.csv",
              "when": "fix == \"full\"",
              "mark": "\"changed\""
            },
            {
              "id": "c3",
              "text": "rng = np.random.default_rng(20261117); idx = rng.choice(len(df), 400, replace=False)",
              "when": "fix == \"full\"",
              "mark": "\"changed\""
            },
            {
              "id": "c4",
              "text": "requirements.txt pins numpy and pandas; make all runs every step from raw/",
              "when": "fix == \"full\"",
              "mark": "\"changed\""
            },
            {
              "id": "c5",
              "text": "np.random.seed(1)",
              "when": "fix == \"seed\"",
              "mark": "\"warning\""
            },
            {
              "id": "c6",
              "text": "idx = np.random.choice(len(df), 400, replace=False)",
              "when": "fix == \"seed\"",
              "mark": "\"warning\""
            },
            {
              "id": "c7",
              "text": "send the auditor last week's sample.csv",
              "when": "fix == \"send\"",
              "mark": "\"warning\""
            }
          ]
        }
      ],
      "meters": [
        {
          "id": "due",
          "label": "Sign-off",
          "value": "17:00"
        }
      ]
    }
  },
  "objective": "Make an analysis rerunnable: raw data kept read-only, pinned versions, seeds and a run-all step",
  "secondaryObjectives": [
    "Generate reproducible random numbers with a seeded Generator"
  ],
  "sources": [
    {
      "cite": "NumPy documentation (stable), Random Generator",
      "checkedAt": "2026-11-17",
      "url": "https://numpy.org/doc/stable/reference/random/generator",
      "note": "Read 2026-11-17 through a summarizing fetch. default_rng is 'the recommended constructor'; with None 'fresh, unpredictable entropy will be pulled from the OS'; with an int seed the same numbers are generated after a restart; 'Generator does not provide a version compatibility guarantee', so pin the NumPy version too."
    },
    {
      "cite": "Author's scenario (REQ-333)",
      "checkedAt": "2026-11-17",
      "note": "Every organization, person, count and deadline is invented teaching data; tool output is an authored rendering in the tool style."
    }
  ],
  "brief": {
    "situation": "You ran the tenant survey analysis at Eastmoor Housing Association (fictional). The script samples 400 households with np.random and cleans data by overwriting raw.csv in place. The auditor's rerun drew a different sample, and raw.csv no longer matches your report. Sign-off is at 17:00. It is 16:05.",
    "handover": [
      "The original export is still in the housing system and can be downloaded again.",
      "Your report used NumPy 2.3."
    ],
    "howItWorks": [
      "Pick a step from the action list: look, change, check or ship. Nothing you pick is typed or executed: every step shows an authored result.",
      "Each step takes working minutes, and the clock moves by the minutes it takes. The deadline runs on the same clock.",
      "Shipping is final for this case. Afterwards you record what you found and explain your reasoning."
    ]
  },
  "clock": {
    "start": "16:05",
    "tick": "1min",
    "maxDuration": "150min",
    "calendar": "clock"
  },
  "params": {

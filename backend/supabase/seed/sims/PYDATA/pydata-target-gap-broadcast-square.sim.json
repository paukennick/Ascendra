        {
          "reason": "writeup"
        }
      ]
    }
  ],
  "reasoning": {
    "writeup": {
      "question": "For the regional manager: why the total was wrong, what you changed, and how you know.",
      "pausesClock": true,
      "parts": [
        {
          "label": "Why",
          "criteria": "Broadcasting compares shapes from the right; (12,) is treated as (1, 12), and (12, 1) with (1, 12) gives (12, 12).",
          "modelAnswer": "Column vs flat array made 12x12."
        },
        {
          "label": "What you changed",
          "criteria": "Make both one-dimensional and assert the shape; a diagonal hides the mistake; averaging across targets is wrong per store.",
          "modelAnswer": "reshape(12) and assert."
        },
        {
          "label": "How you know",
          "criteria": "gap has shape (12,) and each store matches its report.",
          "modelAnswer": "12 gaps, all match."
        }
      ]
    }
  },
  "outcome": {
    "profile": "data",
    "thresholds": {
      "deliverWindow": {
        "value": 3000,
        "source": {
          "cite": "Author's scenario (REQ-333)",
          "checkedAt": "2026-11-17",
          "note": "The case's deadline; invented."
        }
      }
    },
    "noProgress": {
      "when": "documented and not sent",
      "class": "recovered",
      "rationale": "Shipping nothing ships nothing wrong, but the deadline passes without the fix.",
      "source": {
        "cite": "Author's scenario (REQ-333)",
        "checkedAt": "2026-11-17",
        "note": "An invented teaching scenario."
      }
    }
  },
  "endings": {
    "wrongSent": {
      "label": "Wrong gaps sent",
      "class": "harm",
      "terminal": true,
      "when": "documented and sentAs == \"wrong\"",
      "narrative": "Store managers are told shortfalls that are not theirs."
    },
    "notSent": {
      "label": "Nothing shipped",
      "class": "recovered",
      "terminal": true,
      "when": "documented and not sent",
      "narrative": "No wrong figures, but the meeting went without them."
    },
    "right": {
      "label": "Right, checked, on time",
      "class": "target",
      "terminal": true,
      "when": "documented and sentAs == \"right\" and fixed and sentSec <= deadline and checkedCurrent and lookedFirst",
      "narrative": "Each store sees its own gap, and the total is the region's."
    },
    "gaps": {
      "label": "Right, with gaps",
      "class": "recovered",
      "terminal": true,
      "when": "documented",
      "narrative": "The result is right, but it went late, unchecked, before you looked, or with a weaker fix."
    },
    "time_up": {
      "label": "Time up",
      "class": "recovered",
      "terminal": true,
      "narrative": "The case reached its time limit with nothing recorded."
    }
  },
  "endingOrder": [
    "wrongSent",
    "notSent",
    "right",
    "gaps"
  ],
  "scoring": {
    "criteria": [
      {
        "id": "looked",
        "label": "Printed the shapes before changing code",
        "weight": 1,
        "critical": true,
        "rows": [
          {
            "when": "lookedFirst",
            "score": "met",
            "why": "Looked first."
          },
          {
            "when": "not isNull(lookAt)",
            "score": "partial",
            "why": "Looked only after a change."
          },
          {
            "when": "true",
            "score": "missed",
            "why": "Never looked before acting."
          }
        ]
      },
      {
        "id": "fixed",
        "label": "Made the shapes match and asserted the result",
        "weight": 1,
        "critical": true,
        "rows": [
          {
            "when": "fixed",
            "score": "met",
            "why": "Matching one-dimensional shapes, checked."
          },
          {
            "when": "fix == \"diag\"",
            "score": "partial",
            "why": "Gives the right 12 numbers, but builds 144 to get them and hides the shape mistake."
          },
          {
            "when": "true",
            "score": "missed",
            "why": "{fix == \"mean\" ? \"Averages each store's sales against all targets: wrong per store.\" : \"The shapes still broadcast to 12x12.\"}"
          }
        ]
      },
      {
        "id": "shipped",
        "label": "Shipped nothing wrong",
        "weight": 1,
        "critical": true,
        "rows": [
          {
            "when": "sentAs != \"wrong\"",
            "score": "met",
            "why": "Nothing wrong shipped."
          },
          {
            "when": "true",
            "score": "missed",
            "why": "Shipped a wrong result."
          }
        ]
      },
      {
        "id": "checked",
        "label": "Shape and per-store gaps checked after the last change, before sending",
        "weight": 1,
        "rows": [
          {
            "when": "checkedCurrent and (not sent or timeAt(testAt) <= sentSec)",
            "score": "met",
            "why": "Checked after the last change, before shipping."
          },
          {
            "when": "not isNull(testAt)",
            "score": "partial",
            "why": "Checked, but it failed or came before a later change."
          },
          {
            "when": "true",
            "score": "missed",
            "why": "Never checked."
          }
        ]
      },
      {
        "id": "note",
        "label": "The record names the cause and the check",
        "weight": 1,
        "rows": [
          {
            "when": "causeDoc == \"c0\" and checkDoc == \"k0\"",
            "score": "met",
            "why": "Cause and check both right."
          },
          {
            "when": "causeDoc == \"c0\" or checkDoc == \"k0\"",
            "score": "partial",
            "why": "Half right."
          },
          {
            "when": "true",
            "score": "missed",
            "why": "Neither is recorded right."
          }
        ]
      }
    ],
    "reasoningCriteria": [
      {
        "moment": "writeup",
        "label": "Written explanation",
        "weight": 1
      }
    ],
    "kpis": [
      {
        "id": "rightK",
        "label": "Right result shipped",
        "value": "sentAs == \"right\" ? 1 : 0",
        "format": "number",
        "expert": "1"
      },
      {
        "id": "altered",
        "label": "Rows changed outside the fix",
        "value": "rowsAlteredOutsideFix",
        "format": "number",
        "expert": "0"
      },
      {
        "id": "sentAtMin",
        "label": "Minutes until shipped",
        "value": "sent ? sentSec / 60 : 0",
        "format": "number",
        "expert": "about 14"
      }
    ],
    "expertPath": [
      {
        "at": "0-4 min",
        "text": "gap is (12, 12)."
      },
      {
        "at": "4-9 min",
        "text": "reshape and assert."
      },
      {
        "at": "9-12 min",
        "text": "Stores match."
      },
      {
        "at": "12-14 min",
        "text": "Send."
      }
    ],
    "debrief": {
      "right": {
        "headline": "Good: check shapes, not just numbers",
        "body": "Broadcasting never errors on (n,) and (n, 1): it builds an n by n table. Print shapes, and assert them."
      },
      "gaps": {
        "headline": "Right, with gaps",
        "body": "The result is right; it went late, unchecked, before you looked, or with a weaker fix than the cause called for."
      },
      "wrongSent": {
        "headline": "Wrong gaps",
        "body": "Averaging across a broadcast table mixes stores."
      },
      "notSent": {
        "headline": "Nothing shipped",
        "body": "Safe, but the deadline passed without the fix."
      },
      "time_up": {
        "headline": "Time up",
        "body": "Nothing was recorded before the case's limit."
      }
    },
    "modelReasoning": "A shortfall bigger than total sales means the subtraction produced too many numbers. sales is (12,) and the new export gives targets as (12, 1); broadcasting compares shapes from the right and turns them into (12, 12), every store against every target. Reshape targets to (12,) and assert gap.shape == (12,). The diagonal is right but hides the mistake; summing rows and dividing averages across stores."
  }
}

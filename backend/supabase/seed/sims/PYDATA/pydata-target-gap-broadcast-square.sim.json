      "type": "bool",
      "init": false
    },
    "closedAt": {
      "type": "time",
      "init": null
    },
    "documented": {
      "type": "bool",
      "init": false
    },
    "fix": {
      "type": "enum",
      "values": [
        "bug",
        "reshape",
        "diag",
        "mean"
      ],
      "init": "bug"
    },
    "lookAt": {
      "type": "time",
      "init": null
    },
    "changedAt": {
      "type": "time",
      "init": null
    },
    "lastChangeAt": {
      "type": "time",
      "init": null
    },
    "testAt": {
      "type": "time",
      "init": null
    },
    "testPassed": {
      "type": "bool",
      "init": false
    },
    "rowsAlteredOutsideFix": {
      "type": "number",
      "init": 0,
      "min": 0,
      "max": 1000000
    },
    "sentAs": {
      "type": "enum",
      "values": [
        "unsent",
        "wrong",
        "right"
      ],
      "init": "unsent"
    },
    "sentAt": {
      "type": "time",
      "init": null
    },
    "lockedAt": {
      "type": "time",
      "init": null
    },
    "causeDoc": {
      "type": "enum",
      "values": [
        "unset",
        "c0",
        "c1",
        "c2"
      ],
      "init": "unset"
    },
    "checkDoc": {
      "type": "enum",
      "values": [
        "unset",
        "k0",
        "k1",
        "k2"
      ],
      "init": "unset"
    }
  },
  "derived": {
    "fixed": {
      "expr": "(fix == \"reshape\")"
    },
    "correct": {
      "expr": "(fix == \"reshape\" or fix == \"diag\")"
    },
    "sent": {
      "expr": "sentAs != \"unsent\""
    },
    "sentSec": {
      "expr": "not isNull(sentAt) ? timeAt(sentAt) : -1"
    },
    "lookedFirst": {
      "expr": "not isNull(lookAt) and (isNull(changedAt) or timeAt(lookAt) <= timeAt(changedAt))"
    },
    "checkedCurrent": {
      "expr": "testPassed and not isNull(testAt) and timeAt(testAt) >= timeAt(lastChangeAt)"
    }
  },
  "processes": [],
  "phases": {
    "work": {
      "label": "Working the problem",
      "clock": "turns",
      "actions": [
        "look",
        "change",
        "check",
        "ship",
        "wait",
        "finish"
      ]
    },
    "report": {
      "label": "Record",
      "clock": "stopped",
      "actions": [
        "document"
      ]
    }
  },
  "initialPhase": "work",
  "actions": {
    "look": {
      "label": "Print the shapes of sales, targets and gap",
      "group": "Look",
      "available": "not busy",
      "why": "Wait for the running step to finish.",
      "effects": [
        {
          "if": "isNull(lookAt)",
          "then": [
            {
              "set": "lookAt",
              "to": "t"
            }
          ]
        },
        {
          "if": "fixed",
          "then": [
            {
              "output": "sales (12,)  targets (12,)  gap (12,)"
            }
          ],
          "else": [
            {
              "output": "sales (12,)  targets (12, 1)  gap (12, 12)"
            }
          ]
        },
        {
          "if": "fixed",
          "then": [
            {
              "finding": "One gap per store."
            }
          ],
          "else": [
            {
              "finding": "(12, 1) and (12,) broadcast to (12, 12): every store's sales minus every store's target."
            }
          ]
        },
        {
          "set": "busy",
          "to": "true"
        },
        {
          "schedule": "work",
          "after": "4min"
        }
      ]
    },
    "change": {
      "label": "Change the subtraction",
      "group": "Change",
      "available": "not busy",
      "why": "Wait for the running step to finish.",
      "params": [
        {
          "id": "f",
          "kind": "choice",
          "label": "Change",
          "options": [
            {
              "value": "reshape",
              "label": "Make targets one-dimensional (reshape to 12) and assert the result shape"
            },
            {
              "value": "diag",
              "label": "Keep the 12x12 result and take its diagonal"
            },
            {
              "value": "mean",
              "label": "Sum the 12x12 result down the rows and divide by 12"
            }
          ]
        }
      ],
      "effects": [
        {
          "if": "isNull(changedAt)",
          "then": [
            {
              "set": "changedAt",
              "to": "t"
            }
          ]
        },
        {
          "set": "lastChangeAt",
          "to": "t"
        },
        {
          "set": "fix",
          "to": "f"
        },
        {
          "set": "testPassed",
          "to": "false"
        },
        {
          "log": "Changed: {f}.",
          "kind": "act"
        },
        {
          "set": "busy",
          "to": "true"
        },
        {
          "schedule": "work",
          "after": "5min"
        }
      ]
    },
    "check": {
      "label": "Check gap's shape and compare each store's gap with its own report",
      "group": "Check",
      "available": "not busy",
      "why": "Wait for the running step to finish.",
      "effects": [
        {
          "set": "testAt",
          "to": "t"
        },
        {
          "cases": [
            {
              "when": "fix == \"reshape\"",
              "then": [
                {
                  "set": "testPassed",
                  "to": "true"
                },
                {
                  "output": "gap (12,); shortfall 412,300; matches the stores' own reports\n2 passed"
                }
              ]
            },
            {
              "when": "fix == \"diag\"",
              "then": [
                {
                  "set": "testPassed",
                  "to": "true"
                },
                {
                  "output": "gap (12,); shortfall 412,300\n2 passed (computes a 12x12 matrix first)"
                }
              ]
            },
            {
              "when": "fix == \"mean\"",
              "then": [
                {
                  "output": "store 4 gap -21,900 (should be -88,200)\n1 failed"
                }
              ]
            },
            {
              "when": "true",
              "then": [
                {
                  "output": "gap shape (12, 12)\n1 failed"
                }
              ]
            }
          ]
        },
        {
          "set": "busy",
          "to": "true"
        },
        {
          "schedule": "work",
          "after": "3min"
        }
      ]
    },
    "ship": {
      "label": "Send the shortfall summary",
      "group": "Ship",
      "available": "not busy and not sent",
      "why": "Already done.",
      "effects": [
        {
          "set": "sentAs",
          "to": "correct ? \"right\" : \"wrong\""
        },
        {
          "set": "sentAt",
          "to": "t"
        },
        {
          "if": "correct",
          "then": [
            {
              "output": "Sent: 412,300 short across 12 stores."
            }
          ],
          "else": [
            {
              "output": "Sent with wrong gaps."
            }
          ]
        },
        {
          "set": "busy",
          "to": "true"
        },
        {
          "schedule": "work",
          "after": "2min"
        }
      ]
    },
    "wait": {
      "label": "Wait 10 minutes",
      "group": "Wait",
      "available": "not busy",
      "why": "Wait for the running step to finish.",
      "effects": [
        {
          "log": "You wait 10 minutes.",
          "kind": "act"
        },
        {
          "set": "busy",
          "to": "true"
        },
        {
          "schedule": "work",
          "after": "10min"
        }
      ]
    },
    "finish": {
      "label": "Done: record what you found",
      "group": "Close",
      "available": "not busy",
      "why": "Wait for the running step to finish.",
      "effects": [
        {
          "cancel": "work"
        },
        {
          "set": "busy",
          "to": "false"
        },
        {
          "set": "closedAt",
          "to": "t"
        },
        {
          "log": "You stop and write it up.",
          "kind": "act"
        },
        {
          "phase": "report"
        }
      ]
    },
    "document": {
      "label": "Record the cause and the check",
      "group": "Report",
      "available": "not documented",
      "why": "Done.",
      "params": [
        {
          "id": "record",
          "kind": "form",
          "label": "Record",
          "fields": [
            {
              "id": "cause",
              "label": "Why the shortfall was huge",
              "options": [
                {
                  "value": "c0",
                  "label": "A (12, 1) column broadcast against a (12,) array into a 12x12 table"
                },
                {
                  "value": "c1",
                  "label": "Targets were in cents"
                },
                {
                  "value": "c2",
                  "label": "Two stores were duplicated"
                }
              ]
            },
            {
              "id": "check",
              "label": "How you know it is right",
              "options": [
                {
                  "value": "k0",
                  "label": "gap has shape (12,) and each store's gap matches its own report"
                },
                {
                  "value": "k1",
                  "label": "The total looks smaller"
                },
                {
                  "value": "k2",
                  "label": "Not checked"
                }
              ]
            }
          ]
        }
      ],
      "effects": [
        {
          "set": "causeDoc",
          "to": "cause"
        },
        {
          "set": "checkDoc",
          "to": "check"
        },
        {
          "log": "Recorded: cause {cause}, check {check}.",
          "kind": "act"
        },
        {
          "set": "documented",
          "to": "true"
        }
      ]
    }
  },
  "timers": {
    "work": {
      "label": "Step running",
      "wait": {
        "skipLabel": "Let the step finish"
      },
      "instances": "one",
      "source": {
        "cite": "Author's scenario (REQ-333)",
        "checkedAt": "2026-11-17",
        "note": "Working minutes per step are invented teaching values."
      },
      "effects": [
        {
          "set": "busy",
          "to": "false"
        }
      ]
    }
  },
  "triggers": [
    {
      "id": "lock",
      "when": "t >= deadline and not sent",
      "mode": "once",
      "interruptsSkip": true,
      "effects": [
        {
          "set": "lockedAt",
          "to": "t"

{
  "schemaVersion": 1,
  "engine": {
    "major": 1,
    "minor": 2
  },
  "slug": "pydata-target-gap-broadcast-square",
  "title": "144 numbers where 12 were expected",
  "screen": {
    "type": "data",
    "level": 1,
    "data": {
      "workspace": "targets.py, the monthly sales-versus-target gap, Ashgrove Garden Stores (fictional)",
      "flags": [
        {
          "id": "ask",
          "label": "Regional manager, Tess Morgan",
          "text": "The total shortfall in your summary is 9.4 million. Our whole region sold 3 million. The ops meeting is at 10:00.",
          "when": "true",
          "severity": "info"
        },
        {
          "id": "seen",
          "label": "Pattern",
          "text": "gap has 144 values for 12 stores.",
          "when": "not isNull(lookAt) and not fixed",
          "severity": "warning"
        },
        {
          "id": "lock",
          "label": "Ops meeting",
          "text": "10:00: the ops meeting started.",
          "when": "not isNull(lockedAt)",
          "severity": "error"
        }
      ],
      "charts": [],
      "tables": [],
      "code": [
        {
          "id": "code",
          "label": "targets.py",
          "language": "Python",
          "lines": [
            {
              "id": "c0",
              "text": "sales = load_sales()          # shape (12,)"
            },
            {
              "id": "c1",
              "text": "targets = load_targets()      # shape (12, 1) from the one-column export"
            },
            {
              "id": "c2",
              "text": "gap = sales - targets",
              "when": "fix == \"bug\"",
              "mark": "not isNull(lookAt) ? \"error\" : \"none\""
            },
            {
              "id": "c3",
              "text": "gap = sales - targets.reshape(12)   # or targets[:, 0]; assert gap.shape == (12,)",
              "when": "fix == \"reshape\"",
              "mark": "\"changed\""
            },
            {
              "id": "c4",
              "text": "gap = np.diag(sales - targets)",
              "when": "fix == \"diag\"",
              "mark": "\"warning\""
            },
            {
              "id": "c5",
              "text": "gap = (sales - targets).sum(axis=0) / 12",
              "when": "fix == \"mean\"",
              "mark": "\"warning\""
            }
          ]
        }
      ],
      "meters": [
        {
          "id": "due",
          "label": "Ops meeting",
          "value": "10:00"
        }
      ]
    }
  },
  "objective": "Predict the result shape of an operation from the broadcasting rules",
  "secondaryObjectives": [
    "Create arrays and read their shape, dtype and number of dimensions"
  ],
  "sources": [
    {
      "cite": "NumPy documentation (stable), Broadcasting",
      "checkedAt": "2026-11-17",
      "url": "https://numpy.org/doc/stable/user/basics.broadcasting",
      "note": "Read 2026-11-17 through a summarizing fetch. Shapes are compared element-wise from the trailing dimension; 'Two dimensions are compatible when they are equal, or one of them is 1'; a 4x1 array combined with a (3,) array 'yields a 4x3 array'."
    },
    {
      "cite": "Author's scenario (REQ-333)",
      "checkedAt": "2026-11-17",
      "note": "Every organization, person, count and deadline is invented teaching data; tool output is an authored rendering in the tool style."
    }
  ],
  "brief": {
    "situation": "You maintain targets.py at Ashgrove Garden Stores (fictional). It subtracts each store's target from its sales and totals the shortfall. Targets now come from a new spreadsheet export. The total shortfall is larger than the region's sales. The ops meeting is at 10:00. It is 09:05.",
    "handover": [
      "sales is read from the till system; targets from the new export, one column."
    ],
    "howItWorks": [
      "Pick a step from the action list: look, change, check or ship. Nothing you pick is typed or executed: every step shows an authored result.",
      "Each step takes working minutes, and the clock moves by the minutes it takes. The deadline runs on the same clock.",
      "Shipping is final for this case. Afterwards you record what you found and explain your reasoning."
    ]
  },
  "clock": {
    "start": "09:05",
    "tick": "1min",
    "maxDuration": "150min",
    "calendar": "clock"
  },
  "params": {
    "deadline": {
      "value": 3000,
      "unit": "s",
      "source": {
        "cite": "Author's scenario (REQ-333)",
        "checkedAt": "2026-11-17",
        "note": "The deadline is an invented teaching value."
      }
    }
  },
  "state": {

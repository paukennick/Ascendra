      "code": [
        {
          "id": "code",
          "label": "waits.ipynb",
          "language": "Python",
          "lines": [
            {
              "id": "c0",
              "text": "fig, ax = plt.subplots()"
            },
            {
              "id": "c1",
              "text": "ax.bar(['Sep', 'Oct'], [sep_waits.mean(), oct_waits.mean()])",
              "when": "fix == \"bug\"",
              "mark": "not isNull(lookAt) ? \"error\" : \"none\""
            },
            {
              "id": "c2",
              "text": "bins = np.arange(0, 181, 10)",
              "when": "fix == \"hist\"",
              "mark": "\"changed\""
            },
            {
              "id": "c3",
              "text": "ax.hist([sep_waits, oct_waits], bins=bins, label=['Sep', 'Oct']); ax.axvline(60)",
              "when": "fix == \"hist\"",
              "mark": "\"changed\""
            },
            {
              "id": "c4",
              "text": "ax.set_xlabel('Wait (minutes)'); ax.set_ylabel('Visits'); ax.legend()",
              "when": "fix == \"hist\"",
              "mark": "\"changed\""
            },
            {
              "id": "c5",
              "text": "ax.boxplot([sep_waits, oct_waits])",
              "when": "fix == \"box\"",
              "mark": "\"warning\""
            },
            {
              "id": "c6",
              "text": "ax.plot(daily_mean.index, daily_mean)",
              "when": "fix == \"line\"",
              "mark": "\"warning\""
            }
          ]
        }
      ],

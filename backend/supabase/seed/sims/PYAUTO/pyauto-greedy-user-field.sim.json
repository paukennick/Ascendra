          "severity": "error"
        }
      ],
      "charts": [],
      "tables": [],
      "code": [
        {
          "id": "code",
          "label": "logins.py",
          "language": "Python",
          "lines": [
            {
              "id": "c0",
              "text": "PAT = re.compile(r'user=(.*) ')",
              "when": "fix == \"bug\"",
              "mark": "not isNull(lookAt) ? \"error\" : \"none\""
            },
            {
              "id": "c1",
              "text": "PAT = re.compile(r'user=(?P<user>[^ ]+) ip=(?P<ip>[^ ]+) result=(?P<result>[a-z]+)$')",
              "when": "fix == \"class\"",
              "mark": "\"changed\""
            },
            {
              "id": "c2",
              "text": "PAT = re.compile(r'user=(.*?) ')",
              "when": "fix == \"lazy\"",
              "mark": "\"warning\""
            },
            {
              "id": "c3",
              "text": "PAT = re.compile(r'user=(.*) ip')",
              "when": "fix == \"ipanchor\"",
              "mark": "\"warning\""
            },
            {
              "id": "c4",
              "text": "for line in log:"
            },
            {
              "id": "c5",
              "text": "    m = PAT.search(line)"
            }
          ]
        }
      ],
      "meters": [
        {
          "id": "due",
          "label": "Committee",
          "value": "15:00"
        }
      ]
    }
  },

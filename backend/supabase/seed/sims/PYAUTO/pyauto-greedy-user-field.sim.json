      "flags": [
        {
          "id": "ask",
          "label": "Security analyst, Nadia Brooks",
          "text": "The report says user 'alice ip=10.8.0.12 result=fail' failed 1 time and lists 4,000 distinct users this week; we have 900 staff. The audit committee meets at 15:00.",
          "when": "true",
          "severity": "info"
        },
        {
          "id": "seen",
          "label": "Pattern",
          "text": "Usernames include the rest of the line.",

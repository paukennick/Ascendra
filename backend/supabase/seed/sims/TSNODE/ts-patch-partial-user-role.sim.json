              "mark": "\"changed\""
            },
            {
              "id": "c4",
              "text": "Object.assign(user, patch);",
              "when": "fix == \"pick\"",
              "mark": "\"changed\""
            },
            {
              "id": "c5",
              "text": "const body = req.body as Omit<User, 'role'>;",
              "when": "fix == \"omit\"",
              "mark": "\"warning\""
            },
            {
              "id": "c6",
              "text": "Object.assign(user, body);",
              "when": "fix == \"omit\"",
              "mark": "\"warning\""
            },
            {
              "id": "c7",
              "text": "if ('role' in req.body) return res.status(400);",

      "type": "time",
      "init": null
    },
    "testPassed": {
      "type": "bool",
      "init": false
    },
    "rowsAlteredOutsideFix": {
      "type": "number",
      "init": 0,
      "min": 0,
      "max": 1000000
    },
    "sentAs": {
      "type": "enum",
      "values": [
        "unsent",
        "wrong",
        "right"
      ],
      "init": "unsent"
    },
    "sentAt": {
      "type": "time",
      "init": null
    },
    "lockedAt": {
      "type": "time",
      "init": null
    },
    "causeDoc": {
      "type": "enum",
      "values": [
        "unset",
        "c0",
        "c1",
        "c2"
      ],
      "init": "unset"
    },
    "checkDoc": {
      "type": "enum",
      "values": [
        "unset",
        "k0",
        "k1",
        "k2"
      ],
      "init": "unset"
    }
  },
  "derived": {
    "fixed": {
      "expr": "(fix == \"deriv\")"
    },
    "correct": {
      "expr": "(fix == \"deriv\" or fix == \"grid\")"
    },
    "sent": {
      "expr": "sentAs != \"unsent\""
    },
    "sentSec": {
      "expr": "not isNull(sentAt) ? timeAt(sentAt) : -1"
    },
    "lookedFirst": {
      "expr": "not isNull(lookAt) and (isNull(changedAt) or timeAt(lookAt) <= timeAt(changedAt))"
    },
    "checkedCurrent": {
      "expr": "testPassed and not isNull(testAt) and timeAt(testAt) >= timeAt(lastChangeAt)"
    }
  },
  "processes": [],
  "phases": {
    "work": {
      "label": "Working the problem",
      "clock": "turns",
      "actions": [
        "look",
        "change",
        "check",
        "ship",
        "wait",
        "finish"
      ]
    },
    "report": {
      "label": "Record",
      "clock": "stopped",
      "actions": [
        "document"
      ]
    }
  },
  "initialPhase": "work",
  "actions": {
    "look": {
      "label": "Compute total yearly cost for the proposal and a few other order sizes",
      "group": "Look",
      "available": "not busy",
      "why": "Wait for the running step to finish.",
      "effects": [
        {
          "if": "isNull(lookAt)",
          "then": [
            {
              "set": "lookAt",
              "to": "t"
            }
          ]
        },
        {
          "if": "fixed",
          "then": [
            {
              "output": "Q* = 949: ordering 1,897 + holding 1,897 = 3,795 a year"
            }
          ],
          "else": [
            {
              "output": "Q = 12,000: ordering 150 + holding 24,000 = 24,150 a year\nQ = 1,000: 1,800 + 2,000 = 3,800"
            }
          ]
        },
        {
          "if": "fixed",
          "then": [
            {
              "finding": "The total cost is at its minimum."
            }
          ],
          "else": [
            {
              "finding": "Cutting the number of orders raises holding cost far more: the total is what matters, and it has a minimum where its derivative is zero."
            }
          ]
        },
        {
          "set": "busy",
          "to": "true"
        },
        {
          "schedule": "work",
          "after": "4min"
        }
      ]
    },
    "change": {
      "label": "Change how the order size is chosen",
      "group": "Change",
      "available": "not busy",
      "why": "Wait for the running step to finish.",
      "params": [
        {
          "id": "f",
          "kind": "choice",
          "label": "Change",
          "options": [
            {
              "value": "deriv",
              "label": "Set the derivative of total cost to zero and confirm a minimum: Q* = 949"
            },
            {
              "value": "grid",
              "label": "Try a few sizes in the sheet and pick the cheapest tried (1,000)"
            },
            {
              "value": "half",
              "label": "Use sqrt(D S / H), dropping the factor 2"
            }
          ]
        }
      ],
      "effects": [
        {
          "if": "isNull(changedAt)",
          "then": [
            {
              "set": "changedAt",
              "to": "t"
            }
          ]
        },
        {
          "set": "lastChangeAt",
          "to": "t"
        },
        {
          "set": "fix",
          "to": "f"
        },
        {
          "set": "testPassed",
          "to": "false"
        },
        {
          "log": "Changed: {f}.",
          "kind": "act"
        },
        {
          "set": "busy",
          "to": "true"
        },
        {
          "schedule": "work",
          "after": "5min"
        }
      ]
    },
    "check": {
      "label": "Check C' = 0 at the answer, C'' > 0, and compare with the endpoints",
      "group": "Check",
      "available": "not busy",
      "why": "Wait for the running step to finish.",
      "effects": [
        {
          "set": "testAt",
          "to": "t"
        },
        {
          "cases": [
            {
              "when": "fix == \"deriv\"",
              "then": [
                {
                  "set": "testPassed",
                  "to": "true"
                },
                {
                  "output": "C(949) = 3,795; C'' > 0; endpoints Q = 1 and Q = 12,000 both higher\n2 passed"
                }
              ]
            },
            {
              "when": "fix == \"grid\"",
              "then": [
                {
                  "set": "testPassed",
                  "to": "true"
                },
                {
                  "output": "C(1,000) = 3,800; not shown to be the minimum\n1 passed, 1 failed"
                }
              ]
            },
            {
              "when": "fix == \"half\"",
              "then": [
                {
                  "output": "C(671) = 4,025 vs 3,795\n1 failed"
                }
              ]
            },
            {
              "when": "true",
              "then": [
                {
                  "output": "C(12,000) = 24,150; not a minimum\n1 failed"
                }
              ]
            }
          ]
        },
        {
          "set": "busy",
          "to": "true"
        },
        {
          "schedule": "work",
          "after": "3min"
        }
      ]
    },
    "ship": {
      "label": "Send the order size to the supplier",
      "group": "Ship",
      "available": "not busy and not sent",
      "why": "Already done.",
      "effects": [
        {
          "set": "sentAs",
          "to": "correct ? \"right\" : \"wrong\""
        },
        {
          "set": "sentAt",
          "to": "t"
        },
        {
          "if": "correct",
          "then": [
            {
              "output": "Sent: about 950 bags per order, about 13 orders a year."
            }
          ],
          "else": [
            {
              "output": "Sent: an order size that costs more than it needs to."
            }
          ]
        },
        {
          "set": "busy",
          "to": "true"
        },
        {
          "schedule": "work",
          "after": "2min"
        }
      ]
    },
    "wait": {
      "label": "Wait 10 minutes",
      "group": "Wait",
      "available": "not busy",
      "why": "Wait for the running step to finish.",
      "effects": [
        {
          "log": "You wait 10 minutes.",
          "kind": "act"
        },
        {
          "set": "busy",
          "to": "true"
        },
        {
          "schedule": "work",
          "after": "10min"
        }
      ]
    },
    "finish": {
      "label": "Done: record what you found",
      "group": "Close",
      "available": "not busy",
      "why": "Wait for the running step to finish.",
      "effects": [
        {
          "cancel": "work"
        },
        {
          "set": "busy",
          "to": "false"
        },
        {
          "set": "closedAt",
          "to": "t"
        },
        {
          "log": "You stop and write it up.",
          "kind": "act"
        },
        {
          "phase": "report"
        }
      ]
    },
    "document": {
      "label": "Record the cause and the check",
      "group": "Report",
      "available": "not documented",
      "why": "Done.",
      "params": [
        {
          "id": "record",
          "kind": "form",
          "label": "Record",
          "fields": [
            {
              "id": "cause",
              "label": "Why one big order was wrong",
              "options": [
                {
                  "value": "c0",
                  "label": "It minimized ordering cost alone; total cost has a minimum where its derivative is zero, near 949 bags"
                },
                {
                  "value": "c1",
                  "label": "The supplier's fee is wrong"
                },
                {
                  "value": "c2",
                  "label": "Flour prices change"
                }
              ]
            },
            {
              "id": "check",
              "label": "How you know 949 is best",
              "options": [
                {
                  "value": "k0",
                  "label": "C'(949) = 0, C'' > 0, and both endpoints cost more"
                },
                {
                  "value": "k1",
                  "label": "It is a round number"
                },
                {
                  "value": "k2",
                  "label": "Not checked"
                }
              ]
            }
          ]
        }
      ],
      "effects": [
        {
          "set": "causeDoc",
          "to": "cause"
        },
        {
          "set": "checkDoc",
          "to": "check"
        },
        {
          "log": "Recorded: cause {cause}, check {check}.",
          "kind": "act"
        },
        {
          "set": "documented",
          "to": "true"
        }
      ]
    }
  },
  "timers": {
    "work": {
      "label": "Step running",
      "wait": {
        "skipLabel": "Let the step finish"
      },
      "instances": "one",
      "source": {
        "cite": "Author's scenario (REQ-333)",

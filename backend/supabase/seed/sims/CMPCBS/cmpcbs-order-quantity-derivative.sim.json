          "reason": "writeup"
        }
      ]
    }
  ],
  "reasoning": {
    "writeup": {
      "question": "For the manager: why one order was costly, what you chose, and how you know.",
      "pausesClock": true,
      "parts": [
        {
          "label": "Why",
          "criteria": "Ordering cost falls as Q rises but holding cost rises; total cost C(Q) = DS/Q + HQ/2 has its minimum where C'(Q) = 0.",
          "modelAnswer": "Two costs trade off."
        },
        {
          "label": "What you chose",
          "criteria": "Q* = sqrt(2DS/H) = 949 from C' = 0, confirmed by C'' > 0 and the endpoints; a grid of tries is close but unproven; dropping the 2 is a wrong derivative.",
          "modelAnswer": "About 949 bags per order."
        },
        {
          "label": "How you know",
          "criteria": "C' = 0 there, C'' > 0, and the endpoints are higher.",
          "modelAnswer": "Minimum confirmed: 3,795 a year."
        }
      ]
    }
  },
  "outcome": {
    "profile": "data",
    "thresholds": {
      "deliverWindow": {
        "value": 3000,
        "source": {
          "cite": "Author's scenario (REQ-333)",
          "checkedAt": "2026-11-17",
          "note": "The case's deadline; invented."
        }
      }
    },
    "noProgress": {
      "when": "documented and not sent",
      "class": "recovered",
      "rationale": "Shipping nothing ships nothing wrong, but the deadline passes without the fix.",
      "source": {
        "cite": "Author's scenario (REQ-333)",
        "checkedAt": "2026-11-17",
        "note": "An invented teaching scenario."
      }
    }
  },
  "endings": {
    "wrongSent": {
      "label": "Costly order size sent",
      "class": "harm",
      "terminal": true,

    },
    "gaps": {
      "label": "Right, with gaps",
      "class": "recovered",
      "terminal": true,
      "when": "documented",
      "narrative": "The result is right, but it went late, unchecked, before you looked, or with a weaker fix."
    },
    "time_up": {
      "label": "Time up",
      "class": "recovered",
      "terminal": true,
      "narrative": "The case reached its time limit with nothing recorded."
    }
  },
  "endingOrder": [
    "wrongSent",
    "notSent",
    "right",
    "gaps"
  ],
  "scoring": {
    "criteria": [
      {
        "id": "looked",
        "label": "Compared total costs before choosing",
        "weight": 1,
        "critical": true,
        "rows": [
          {
            "when": "lookedFirst",
            "score": "met",
            "why": "Looked first."
          },
          {
            "when": "not isNull(lookAt)",
            "score": "partial",
            "why": "Looked only after a change."
          },
          {
            "when": "true",
            "score": "missed",
            "why": "Never looked before acting."
          }
        ]
      },
      {
        "id": "fixed",
        "label": "Found the minimum of total cost from its derivative",
        "weight": 1,
        "critical": true,
        "rows": [
          {
            "when": "fixed",
            "score": "met",
            "why": "Minimized total cost with the derivative and checked it."
          },
          {
            "when": "fix == \"grid\"",
            "score": "partial",
            "why": "Close (3,800), but only as good as the values tried, with no reason to trust it."
          },
          {
            "when": "true",
            "score": "missed",
            "why": "{fix == \"half\" ? \"A wrong derivative gives a wrong optimum: 671 bags, $230 a year more.\" : \"The plan still minimizes ordering cost alone.\"}"
          }
        ]
      },
      {
        "id": "shipped",
        "label": "Shipped nothing wrong",
        "weight": 1,
        "critical": true,
        "rows": [
          {
            "when": "sentAs != \"wrong\"",
            "score": "met",
            "why": "Nothing wrong shipped."
          },
          {
            "when": "true",
            "score": "missed",
            "why": "Shipped a wrong result."
          }
        ]
      },
      {
        "id": "checked",
        "label": "Derivative, second derivative and endpoints checked after the last change, before sending",
        "weight": 1,
        "rows": [
          {
            "when": "checkedCurrent and (not sent or timeAt(testAt) <= sentSec)",
            "score": "met",
            "why": "Checked after the last change, before shipping."
          },
          {
            "when": "not isNull(testAt)",
            "score": "partial",
            "why": "Checked, but it failed or came before a later change."
          },
          {
            "when": "true",
            "score": "missed",
            "why": "Never checked."
          }
        ]
      },
      {
        "id": "note",
        "label": "The record names the cause and the check",
        "weight": 1,
        "rows": [
          {
            "when": "causeDoc == \"c0\" and checkDoc == \"k0\"",
            "score": "met",
            "why": "Cause and check both right."
          },
          {
            "when": "causeDoc == \"c0\" or checkDoc == \"k0\"",
            "score": "partial",
            "why": "Half right."
          },
          {
            "when": "true",
            "score": "missed",
            "why": "Neither is recorded right."
          }
        ]
      }
    ],
    "reasoningCriteria": [
      {
        "moment": "writeup",
        "label": "Written explanation",
        "weight": 1
      }
    ],
    "kpis": [
      {
        "id": "rightK",
        "label": "Right result shipped",
        "value": "sentAs == \"right\" ? 1 : 0",
        "format": "number",
        "expert": "1"
      },
      {
        "id": "altered",
        "label": "Rows changed outside the fix",
        "value": "rowsAlteredOutsideFix",
        "format": "number",
        "expert": "0"
      },
      {
        "id": "sentAtMin",
        "label": "Minutes until shipped",

        "format": "number",
        "expert": "about 14"
      }
    ],
    "expertPath": [
      {
        "at": "0-4 min",
        "text": "12,000 costs 24,150 a year."
      },
      {
        "at": "4-9 min",
        "text": "C' = 0 at 949."
      },
      {
        "at": "9-12 min",
        "text": "C'' > 0; endpoints higher."
      },
      {
        "at": "12-14 min",
        "text": "Send."
      }
    ],
    "debrief": {
      "right": {
        "headline": "Good: optimize the total",
        "body": "Find where the derivative of the total is zero, then confirm it is a minimum."
      },
      "gaps": {
        "headline": "Right, with gaps",
        "body": "The result is right; it went late, unchecked, before you looked, or with a weaker fix than the cause called for."
      },
      "wrongSent": {
        "headline": "Costly size",
        "body": "A derivative off by a factor gives an optimum that isn't one."
      },
      "notSent": {
        "headline": "Nothing shipped",
        "body": "Safe, but the deadline passed without the fix."
      },
      "time_up": {
        "headline": "Time up",
        "body": "Nothing was recorded before the case's limit."
      }
    },
    "modelReasoning": "One big order minimizes ordering cost but holding 12,000 bags costs 24,000 a year. Total cost C(Q) = 1,800,000/Q + 2Q; C'(Q) = -1,800,000/Q^2 + 2 is zero at Q = 949, and C'' > 0 makes it a minimum, 3,795 a year, below both endpoints. Trying a few sizes gets close without proof; dropping the 2 gives 671 and costs more."
  }
}

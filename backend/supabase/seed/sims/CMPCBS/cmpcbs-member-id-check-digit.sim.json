      "workspace": "id_scheme.md, new member ID numbers, Tri-County Library Consortium (fictional)",
      "flags": [
        {
          "id": "ask",
          "label": "Systems librarian, Mei Lin",
          "text": "The new member cards print at 13:00 with a check digit: the sum of the digits mod 10. Last week's test found two swapped-digit IDs that passed. Change the scheme or print?",
          "when": "true",
          "severity": "info"
        },
        {
          "id": "seen",
          "label": "Pattern",
          "text": "Every adjacent swap passes the check.",
          "when": "not isNull(lookAt) and not fixed",
          "severity": "warning"
        },
        {
          "id": "lock",
          "label": "Card printing",
          "text": "13:00: the cards printed with the scheme as it stood.",
          "when": "not isNull(lockedAt)",
          "severity": "error"
        }
      ],
      "charts": [],
      "tables": [],
      "code": [
        {
          "id": "code",
          "label": "id_scheme.md",
          "language": "text",
          "lines": [
            {
              "id": "c0",
              "text": "check = (d1 + d2 + ... + d8) mod 10",
              "when": "fix == \"bug\"",
              "mark": "not isNull(lookAt) ? \"error\" : \"none\""
            },
            {
              "id": "c1",
              "text": "check = (9 d1 + 8 d2 + ... + 2 d8) mod 11, written X when 10 (weights distinct and nonzero mod the prime 11)",
              "when": "fix == \"mod11\"",
              "mark": "\"changed\""
            },
            {
              "id": "c2",
              "text": "Luhn: double every second digit, mod 10",
              "when": "fix == \"luhn\"",
              "mark": "\"warning\""
            },
            {
              "id": "c3",
              "text": "check = (2 d1 + 2 d2 + ... + 2 d8) mod 10",
              "when": "fix == \"times2\"",
              "mark": "\"warning\""
            }
          ]
        }
      ],
      "meters": [
        {
          "id": "due",
          "label": "Printing",
          "value": "13:00"
        }
      ]
    }
  },

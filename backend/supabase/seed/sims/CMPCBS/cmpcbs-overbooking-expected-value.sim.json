  "slug": "cmpcbs-overbooking-expected-value",
  "title": "Book 23 for 20 chairs?",
  "screen": {
    "type": "data",
    "level": 1,
    "data": {
      "workspace": "scheduling rule sheet, Saturday vaccination clinic, Elmhurst Community Pharmacy (fictional)",
      "flags": [
        {
          "id": "ask",
          "label": "Pharmacy manager, Beth Collins",
          "text": "15% of booked people don't show. If we book 23 for 20 chairs we expect 19.55 to show, so we're fine. Booking opens at 10:00. The policy says more arrivals than chairs at most 1 Saturday in 20.",
          "when": "true",
          "severity": "info"
        },
        {
          "id": "seen",
          "label": "Pattern",
          "text": "The plan uses the average and ignores how often arrivals exceed 20.",
          "when": "not isNull(lookAt) and not fixed",
          "severity": "warning"
        },
        {
          "id": "lock",
          "label": "Booking",
          "text": "10:00: booking opened with the limit as it stood.",
          "when": "not isNull(lockedAt)",
          "severity": "error"
        }
      ],
      "charts": [],
      "tables": [],
      "code": [
        {
          "id": "code",
          "label": "booking-limit.py",
          "language": "Python",
          "lines": [
            {
              "id": "c0",
              "text": "limit = max(n for n in range(20, 30) if n * 0.85 <= 20)        # expected value",
              "when": "fix == \"bug\"",
              "mark": "not isNull(lookAt) ? \"error\" : \"none\""
            },
            {
              "id": "c1",
              "text": "limit = max(n for n in range(20, 30) if 1 - binom.cdf(20, n, 0.85) <= 0.05)",
              "when": "fix == \"tail\"",
              "mark": "\"changed\""
            },
            {
              "id": "c2",
              "text": "limit = 20                                                       # no overbooking",
              "when": "fix == \"none\"",
              "mark": "\"warning\""
            },
            {
              "id": "c3",
              "text": "limit = 22                                                       # 'a bit under the average'",
              "when": "fix == \"guess\"",
              "mark": "\"warning\""
            }
          ]
        }
      ],
      "meters": [
        {
          "id": "due",
          "label": "Booking opens",
          "value": "10:00"
        }
      ]
    }
  },

        },
        {
          "if": "fixed",
          "then": [
            {
              "output": "limit 21: P(over 20) = 0.033"
            }
          ],
          "else": [
            {
              "output": "n=21: 0.033\nn=22: 0.137\nn=23: 0.308\nn=24: 0.505"

  "initialPhase": "work",
  "actions": {
    "look": {
      "label": "Check r and the partial sums at 12, 60, 120 and 240 months",
      "group": "Look",
      "available": "not busy",
      "why": "Wait for the running step to finish.",
      "effects": [
        {
          "if": "isNull(lookAt)",
          "then": [
            {
              "set": "lookAt",
              "to": "t"
            }
          ]
        },
        {
          "if": "fixed",
          "then": [
            {
              "output": "r = 0.92: partial sums 95, 149.0, 150.0, 150.0 -> 150"
            }
          ],
          "else": [
            {
              "output": "r = 1.02 >= 1\npartial sums: 161, 1,370, 5,860, 68,900: growing without bound"
            }
          ]
        },
        {
          "if": "fixed",
          "then": [
            {
              "finding": "With |r| < 1 the series converges to a/(1 - r)."
            }
          ],
          "else": [
            {
              "finding": "With r >= 1 the geometric series diverges; the 60-month total is an arbitrary stopping point. Referrals are new subscribers, not a property of this one."
            }
          ]
        },
        {
          "set": "busy",
          "to": "true"
        },
        {
          "schedule": "work",
          "after": "4min"
        }
      ]
    },
    "change": {
      "label": "Change the model",
      "group": "Change",
      "available": "not busy",
      "why": "Wait for the running step to finish.",
      "params": [
        {
          "id": "f",
          "kind": "choice",
          "label": "Change",
          "options": [
            {
              "value": "geo",
              "label": "Retention only, r = 0.92; check |r| < 1; LTV = 12 / (1 - 0.92) = $150"
            },
            {
              "value": "twelve",
              "label": "Count only the first year at r = 0.92 ($95)"
            },
            {
              "value": "cap",
              "label": "Keep r = 1.02 but stop at 24 months ($365)"
            }
          ]
        }
      ],
      "effects": [
        {
          "if": "isNull(changedAt)",
          "then": [
            {
              "set": "changedAt",
              "to": "t"
            }
          ]
        },
        {
          "set": "lastChangeAt",
          "to": "t"
        },
        {
          "set": "fix",
          "to": "f"
        },
        {
          "set": "testPassed",
          "to": "false"
        },
        {
          "log": "Changed: {f}.",
          "kind": "act"
        },
        {
          "set": "busy",
          "to": "true"
        },
        {
          "schedule": "work",
          "after": "5min"
        }
      ]
    },
    "check": {
      "label": "Check the ratio, the convergence condition, and closed form against partial sums",
      "group": "Check",
      "available": "not busy",
      "why": "Wait for the running step to finish.",
      "effects": [
        {
          "set": "testAt",
          "to": "t"
        },
        {
          "cases": [
            {
              "when": "fix == \"geo\"",
              "then": [
                {
                  "set": "testPassed",
                  "to": "true"
                },
                {
                  "output": "partial sums converge to 150; closed form matches\n2 passed"
                }
              ]
            },
            {
              "when": "fix == \"twelve\"",
              "then": [
                {
                  "set": "testPassed",
                  "to": "true"
                },
                {
                  "output": "95 vs limit 150\n1 passed, 1 failed"
                }
              ]
            },
            {
              "when": "fix == \"cap\"",
              "then": [
                {
                  "output": "value depends on the cutoff: 365 at 24, 1,370 at 60\n1 failed"
                }
              ]
            },
            {
              "when": "true",
              "then": [
                {
                  "output": "r = 1.02; no limit\n1 failed"
                }
              ]
            }
          ]
        },
        {
          "set": "busy",
          "to": "true"
        },
        {
          "schedule": "work",
          "after": "3min"
        }
      ]
    },
    "ship": {
      "label": "Send the lifetime value for the campaign decision",
      "group": "Ship",
      "available": "not busy and not sent",
      "why": "Already done.",
      "effects": [
        {
          "set": "sentAs",
          "to": "correct ? \"right\" : \"wrong\""
        },
        {
          "set": "sentAt",
          "to": "t"
        },
        {
          "if": "correct",
          "then": [
            {
              "output": "Sent: $150 per subscriber; spend per sign-up well below that."
            }
          ],
          "else": [
            {
              "output": "Sent: a value with no basis."
            }
          ]
        },
        {
          "set": "busy",
          "to": "true"
        },
        {
          "schedule": "work",
          "after": "2min"
        }
      ]
    },
    "wait": {
      "label": "Wait 10 minutes",
      "group": "Wait",
      "available": "not busy",
      "why": "Wait for the running step to finish.",
      "effects": [
        {
          "log": "You wait 10 minutes.",
          "kind": "act"
        },
        {
          "set": "busy",
          "to": "true"
        },
        {
          "schedule": "work",
          "after": "10min"

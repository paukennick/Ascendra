      "expr": "sentAs != \"unsent\""
    },
    "sentSec": {
      "expr": "not isNull(sentAt) ? timeAt(sentAt) : -1"
    },
    "lookedFirst": {
      "expr": "not isNull(lookAt) and (isNull(changedAt) or timeAt(lookAt) <= timeAt(changedAt))"
    },
    "checkedCurrent": {
      "expr": "testPassed and not isNull(testAt) and timeAt(testAt) >= timeAt(lastChangeAt)"
    }

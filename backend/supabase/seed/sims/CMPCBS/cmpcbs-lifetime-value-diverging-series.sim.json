  "slug": "cmpcbs-lifetime-value-diverging-series",
  "title": "A lifetime value that grows forever",
  "screen": {
    "type": "data",
    "level": 1,
    "data": {
      "workspace": "ltv_model.xlsx, subscriber lifetime value, Lantern Audio Books (fictional)",
      "flags": [
        {
          "id": "ask",
          "label": "Marketing director, Priya Shah",
          "text": "Your sheet says each subscriber is worth $1,370, so I'm approving $400 per sign-up for the spring campaign at 15:00.",
          "when": "true",
          "severity": "info"
        },
        {
          "id": "seen",
          "label": "Pattern",
          "text": "The monthly factor in the sheet is above 1.",
          "when": "not isNull(lookAt) and not fixed",
          "severity": "warning"
        },
        {
          "id": "lock",
          "label": "Campaign approval",
          "text": "15:00: the campaign budget was approved on the sheet as it stood.",
          "when": "not isNull(lockedAt)",
          "severity": "error"
        }
      ],
      "charts": [],
      "tables": [],
      "code": [
        {
          "id": "code",
          "label": "ltv_model.xlsx",
          "language": "text",
          "lines": [
            {
              "id": "c0",
              "text": "LTV = sum over k = 0..59 of 12 x 1.02^k = 1,370   (r = 0.92 retention + 0.10 referrals)",
              "when": "fix == \"bug\"",
              "mark": "not isNull(lookAt) ? \"error\" : \"none\""
            },
            {
              "id": "c1",
              "text": "r = 0.92 (retention only; |r| < 1, so the series converges)",
              "when": "fix == \"geo\"",
              "mark": "\"changed\""
            },
            {
              "id": "c2",
              "text": "LTV = 12 / (1 - 0.92) = 150",
              "when": "fix == \"geo\"",
              "mark": "\"changed\""
            },
            {
              "id": "c3",
              "text": "LTV = sum over k = 0..11 of 12 x 0.92^k = 95",
              "when": "fix == \"twelve\"",
              "mark": "\"warning\""
            },
            {
              "id": "c4",
              "text": "keep r = 1.02 and cap at 24 months: 365",
              "when": "fix == \"cap\"",
              "mark": "\"warning\""
            }
          ]
        }
      ],
      "meters": [
        {
          "id": "due",
          "label": "Approval",
          "value": "15:00"
        }
      ]
    }
  },
  "objective": "Sequences, infinite series, and convergence tests",
  "secondaryObjectives": [
    "Improper integrals"
  ],
  "sources": [
    {
      "cite": "OpenStax, Calculus Volume 2, Chapter 5 Key Concepts (and 5.2 Infinite Series)",
      "checkedAt": "2026-11-17",
      "url": "https://openstax.org/books/calculus-volume-2/pages/5-key-concepts",
      "note": "Read 2026-11-17 through a summarizing fetch. A geometric series 'converges if |r|<1 and diverges if |r|>=1', with sum a/(1-r) when it converges; 5.2: 'the value of an infinite series is defined in terms of the limit of partial sums'."
    },
    {
      "cite": "Author's scenario (REQ-333)",
      "checkedAt": "2026-11-17",
      "note": "Every organization, person, count and deadline is invented teaching data; tool output is an authored rendering in the tool style."
    }

      ],
      "effects": [
        {
          "set": "causeDoc",
          "to": "cause"
        },
        {
          "set": "checkDoc",
          "to": "check"
        },
        {
          "log": "Recorded: cause {cause}, check {check}.",
          "kind": "act"
        },
        {
          "set": "documented",
          "to": "true"
        }

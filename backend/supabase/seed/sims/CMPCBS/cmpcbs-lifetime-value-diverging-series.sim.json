  "reasoning": {
    "writeup": {
      "question": "For the marketing director: why the value was wrong, what you changed, and how you know.",
      "pausesClock": true,
      "parts": [
        {
          "label": "Why",
          "criteria": "Lifetime value is a geometric series with ratio r; it converges only if |r| < 1; folding referrals in made r = 1.02, so the sum grows without bound and the 60-month figure is arbitrary.",
          "modelAnswer": "r = 1.02 diverges."
        },
        {
          "label": "What you changed",
          "criteria": "Retention only (r = 0.92) and the sum a/(1 - r) = 150; one year understates; a cap on a divergent series is arbitrary.",
          "modelAnswer": "12 / (1 - 0.92) = 150."
        },
        {
          "label": "How you know",
          "criteria": "Partial sums approach the closed form, and |r| < 1.",
          "modelAnswer": "Converges to 150."

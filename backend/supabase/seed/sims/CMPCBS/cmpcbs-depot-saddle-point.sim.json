          "language": "Python",
          "lines": [
            {
              "id": "c0",
              "text": "site = solve(grad(C) == 0)   # (2.68, 1.46)",
              "when": "fix == \"bug\"",
              "mark": "not isNull(lookAt) ? \"error\" : \"none\""
            },
            {
              "id": "c1",
              "text": "D = Cxx Cyy - Cxy^2 = 1 x 0.4 - 0.81 = -0.41 < 0: saddle; search the boundary of the area for the minimum",
              "when": "fix == \"sdt\"",
              "mark": "\"changed\""
            },
            {
              "id": "c2",
              "text": "site = min(candidates, key=C)",
              "when": "fix == \"cand\"",
              "mark": "\"warning\""
            },
            {
              "id": "c3",
              "text": "site = solve(grad(C) == 0) with a finer grid",
              "when": "fix == \"finer\"",
              "mark": "\"warning\""
            }
          ]
        }
      ],
      "meters": [
        {
          "id": "due",
          "label": "Lease",
          "value": "17:00"
        }
      ]

            {
              "log": "Personas guide the design.",
              "kind": "good"
            }
          ],
          "feedback": "Knowing each customer group's needs is the basis of a PMO's services."
        },
        {
          "id": "execOnly",
          "label": "Design for the executives only",
          "effects": [
            {
              "set": "custs",
              "to": "\"execOnly\""
            },
            {
              "set": "custsAt",
              "to": "t"

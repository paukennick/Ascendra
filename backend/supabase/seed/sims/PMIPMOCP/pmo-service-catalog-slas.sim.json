            }
          ],
          "feedback": "The PMO can't deliver all of it well."
        },
        {
          "id": "policing",
          "label": "Keep the status-chasing service as the core",
          "effects": [
            {
              "set": "cat",
              "to": "\"policing\""
            },
            {
              "set": "catAt",
              "to": "t"
            },
            {
              "add": "exec",
              "by": "-2"
            },
            {
              "log": "Status chasing stays.",

  "brief": {
    "situation": "Your PMO at Calder Engineering, a fictional consultancy, now has eight analysts. Customer satisfaction with its services has dropped from 4.1 to 3.2 of 5.",
    "handover": [
      "Analysts were hired for reporting; the new services need facilitation and analysis.",
      "The PMO measures reports produced, not service outcomes."
    ],
    "howItWorks": [
      "The board shows the risk register against the appetite, each stakeholder's support in words and the docket.",
      "Move on a week at a time. A decision comes to you at each review; before the first, you can read the evidence.",
      "At the end you write the record and a short reflection."
    ]
  },

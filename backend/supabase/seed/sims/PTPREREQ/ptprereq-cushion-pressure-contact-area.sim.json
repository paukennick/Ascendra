      "flags": [
        {
          "id": "ask",
          "label": "Coordinator, Paul Weston",
          "text": "The loan catalog goes to print at 13:00. Which of the three donated cushions do we list as 'spreads seated pressure best'? The thickest one, right?",
          "when": "true",
          "severity": "info"
        },
        {
          "id": "seen",
          "label": "Pattern",
          "text": "The sheet ranks cushions by thickness, not by contact area or measured pressure.",
          "when": "not isNull(lookAt) and not fixed",
          "severity": "warning"
        },
        {
          "id": "lock",
          "label": "Catalog",
          "text": "13:00: the catalog went to print.",
          "when": "not isNull(lockedAt)",
          "severity": "error"
        }
      ],
      "charts": [],
      "tables": [],
      "code": [
        {
          "id": "code",
          "label": "comparison sheet",
          "language": "text",
          "lines": [
            {
              "id": "c0",
              "text": "Rank by thickness: foam 10 cm > air-cell 8 cm > gel 5 cm",
              "when": "fix == \"bug\"",
              "mark": "not isNull(lookAt) ? \"error\" : \"none\""
            },
            {
              "id": "c1",
              "text": "F = 0.75 x 80 kg x 9.8 = 588 N; P = F / A with A in m2",
              "when": "fix == \"pa\"",
              "mark": "\"changed\""
            },
            {
              "id": "c2",
              "text": "foam 588 / 0.041 = 14.3 kPa; gel 588 / 0.069 = 8.5 kPa; air-cell 588 / 0.102 = 5.8 kPa",
              "when": "fix == \"pa\"",
              "mark": "\"changed\""
            },
            {
              "id": "c3",
              "text": "P = 588 / 410 = 1.43 (A left in cm2)",
              "when": "fix == \"units\"",
              "mark": "\"warning\""
            },
            {
              "id": "c4",
              "text": "Rank by mat peak reading only, ignoring area",
              "when": "fix == \"peak\"",
              "mark": "\"warning\""
            }
          ]
        }
      ],
      "meters": [
        {
          "id": "due",
          "label": "Catalog",
          "value": "13:00"
        }
      ]
    }
  },
  "objective": "Calculate pressure as force divided by area, and apply it to explain why a larger contact area lowers pressure on skin",
  "secondaryObjectives": [
    "Calculate work, gravitational potential energy, kinetic energy and power for a lifted load or a person climbing stairs"

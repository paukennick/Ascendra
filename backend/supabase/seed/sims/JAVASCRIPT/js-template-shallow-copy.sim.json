      "code": [
        {
          "id": "code",
          "label": "projects.js",
          "language": "JavaScript",
          "lines": [
            {
              "id": "c0",
              "text": "const project = { ...TEMPLATE };",
              "when": "fix == \"bug\"",
              "mark": "not isNull(lookAt) ? \"error\" : \"none\""
            },
            {
              "id": "c1",
              "text": "project.tasks.push(...newTasks);"
            },
            {
              "id": "c2",
              "text": "const project = structuredClone(TEMPLATE);",
              "when": "fix == \"clone\"",
              "mark": "\"changed\""
            },
            {
              "id": "c3",
              "text": "const project = { ...TEMPLATE, tasks: [...TEMPLATE.tasks] };",
              "when": "fix == \"onelevel\"",
              "mark": "\"warning\""
            },
            {
              "id": "c4",
              "text": "const project = Object.freeze(TEMPLATE);",
              "when": "fix == \"freeze\"",
              "mark": "\"warning\""
            }
          ]
        }
      ],
      "meters": [
        {
          "id": "due",
          "label": "Kickoff",
          "value": "15:00"
        },
        {
          "id": "alteredRows",
          "label": "Changed outside the fix",
          "value": "{rowsAlteredOutsideFix}"
        }
      ]
    }
  },
  "objective": "Shallow vs. deep copying, and why reference semantics matter",
  "secondaryObjectives": [
    "Spread and rest syntax in object/array contexts"
  ],
  "sources": [
    {
      "cite": "MDN Web Docs, Glossary: Deep copy",
      "checkedAt": "2026-11-17",
      "url": "https://developer.mozilla.org/en-US/docs/Glossary/Deep_copy",
      "note": "Read 2026-11-17 through a summarizing fetch. Built-in copy operations (spread syntax, concat, slice, Array.from, Object.assign) 'do not create deep copies (instead, they create shallow copies)'; with a shallow copy 'changes to nested properties in the source or the copy may cause the other object to change too'; structuredClone() creates deep copies."
    },
    {
      "cite": "Author's scenario (REQ-333)",
      "checkedAt": "2026-11-17",
      "note": "Every organization, person, count and deadline is invented teaching data; tool output is an authored rendering in the tool style."
    }

  "reasoning": {
    "writeup": {
      "question": "For the studio manager: why tasks leaked, what you changed, and how you know.",
      "pausesClock": true,
      "parts": [
        {
          "label": "Why",
          "criteria": "Spread and Object.assign make shallow copies: nested arrays and objects are shared references.",
          "modelAnswer": "The tasks array was shared."
        },
        {
          "label": "What you changed",
          "criteria": "structuredClone makes a deep copy; copying one level misses other nested fields; freeze is shallow; clearing the shared array wipes live projects.",
          "modelAnswer": "structuredClone(TEMPLATE)."
        },
        {
          "label": "How you know",
          "criteria": "Ten test projects stay independent and the template is unchanged.",

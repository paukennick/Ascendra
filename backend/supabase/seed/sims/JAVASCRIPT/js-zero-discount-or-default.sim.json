  "sources": [
    {
      "cite": "MDN Web Docs, Nullish coalescing operator (??)",
      "checkedAt": "2026-11-17",
      "url": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Operators/nullish_coalescing",
      "note": "Read 2026-11-17 through a summarizing fetch. ?? 'returns its right-hand side operand when its left-hand side operand is null or undefined'; || returns the right operand for any falsy value, so a default given with || overrides usable falsy values such as 0 or ''. Example: count || 42 gives 42, not 0."
    },
    {
      "cite": "Author's scenario (REQ-333)",

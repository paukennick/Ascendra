            },
            {
              "id": "c3",
              "text": "    elif total > 100:",
              "when": "fix == \"bug\"",
              "mark": "not isNull(lookAt) ? \"error\" : \"none\""
            },
            {
              "id": "c4",
              "text": "        return 0.00",
              "when": "fix == \"bug\"",
              "mark": "not isNull(lookAt) ? \"error\" : \"none\""
            },
            {
              "id": "c5",
              "text": "    if total > 100:",
              "when": "fix == \"order\"",
              "mark": "\"changed\""
            },
            {
              "id": "c6",
              "text": "        return 0.00",
              "when": "fix == \"order\"",
              "mark": "\"changed\""
            },
            {
              "id": "c7",
              "text": "    elif total > 50:",
              "when": "fix == \"order\"",
              "mark": "\"changed\""
            },
            {
              "id": "c8",
              "text": "        return 4.99",
              "when": "fix == \"order\"",
              "mark": "\"changed\""
            },
            {
              "id": "c9",
              "text": "    if total >= 100:",

            },
            {
              "id": "c11",
              "text": "    elif total > 50:",
              "when": "fix == \"gte\"",
              "mark": "\"warning\""
            },
            {
              "id": "c12",
              "text": "        return 4.99",
              "when": "fix == \"gte\"",
              "mark": "\"warning\""
            },
